@using MudBlazor
@using Mythetech.Framework.Components.Settings
@using Mythetech.Framework.Infrastructure.Settings
@using Aion.Components.Theme

@* Every edit is saved as it is made, so Done, the close button, Esc and the backdrop all just close. *@
<MudDialog Class="mf-settings-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">
                <MudIcon Color="Color.Primary" Class="mr-4" Icon="@AionIcons.Settings" />
                Settings
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@AionIcons.Close" OnClick="Close" aria-label="Close settings" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="mf-settings-dialog-content">
            <SettingsPanel ShowTitle="false" OnSettingsChanged="SaveChangesAsync" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private SettingsState Settings { get; set; } = default!;

    [Inject]
    private ISettingsProvider SettingsProvider { get; set; } = default!;

    private SettingsChangeTracker _changes = default!;

    protected override void OnInitialized()
    {
        _changes = new SettingsChangeTracker(SettingsProvider.GetAllSettings());
    }

    private async Task SaveChangesAsync()
    {
        foreach (var settings in _changes.TakeChanged(SettingsProvider.GetAllSettings()))
        {
            await Settings.SaveAsync(settings);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
