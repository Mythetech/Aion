@using Aion.Components.Theme
@using Aion.Components.Shared
@implements IDisposable

@foreach (var entry in State.Entries)
{
    <MudStack Row="true" Class="w-100">
        <TooltipIcon Text="@entry.ExecutedAt.ToString("G")" Icon="@AionIcons.Round("schedule")"/>
        <MudText Class="flex-grow-1 text-truncate">@entry.Sql</MudText>
        @if (entry.Status == QueryHistoryStatus.Cancelled)
        {
            <TooltipIcon Text="Cancelled" Icon="@AionIcons.Round("hide_source")" />
        }
        else
        {
            <TooltipIcon Text="@entry.ErrorMessage"
                         Color="@(entry.Status == QueryHistoryStatus.Success ? Color.Success : Color.Error)"
                         Icon="@(entry.Status == QueryHistoryStatus.Success ? AionIcons.Success : AionIcons.Close)" />
        }
    </MudStack>
}

@if (State.Entries.Count < 1)
{
    <MudContainer>
        <MudStack>
            <MudText>No History</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Queries will automatically be saved to history</MudText>
        </MudStack>
    </MudContainer>
}

@code {
    [Inject]
    protected HistoryState State { get; set; } = default!;

    protected override void OnInitialized()
    {
        State.HistoryChanged += StateHasChanged;
    }

    public void Dispose()
    {
        State.HistoryChanged -= StateHasChanged;
    }
}
