@using Aion.Components.CommandPalette.Commands
@using Aion.Components.Connections
@using Aion.Components.Connections.Commands
@using Mythetech.Framework.Infrastructure.MessageBus
@using Aion.Components.Querying.Commands
@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages
@using Aion.Components.Shared
@using Aion.Components.Shared.Snackbar.Commands
@using Aion.Components.Shortcuts
@using Aion.Components.Theme
@using Aion.Components.Settings.Domains
@using Aion.Contracts.Connections
@using Aion.Contracts.Queries
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Mythetech.Framework.Infrastructure.Guards
@using Mythetech.Framework.Infrastructure.Settings.Events
@using System.Threading.Channels
@implements IAsyncDisposable
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.Querying.Commands.FocusQuery>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.Querying.Commands.CreateQuery>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.Querying.Commands.RunQuery>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.Querying.Commands.GoToQueryPosition>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Mythetech.Framework.Infrastructure.Settings.Events.SettingsModelChanged<Aion.Components.Settings.Domains.EditorSettings>>


<MudStack Class="h-100" Spacing="0">
    <Aion.Components.Querying.TabBar.AionTabBar OnTabActivated="OnTabChanged" OnAddQuery="QueryAddClicked" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="editor-toolbar pa-2">
        @if (State?.Active is { } active)
        {
            <RunQueryButton OnClick="RunQuery"
                            Disabled="@(!CanExecuteQuery)"
                            DisabledReason="@RunBlockedReason"
                            Hint="@RunHint(active)"
                            Shortcut="@Keys.Describe(Keys.RunQuery)"
                            IsExecuting="@active.IsExecuting"
                            HasSelection="@_editorHasSelection"
                            OnRunSelection="RunSelection"
                            ShowExplain="@CanExplain"
                            OnExplain="Explain"
                            ShowExplainAnalyze="@CanExplainAnalyze"
                            ExplainAnalyzeBlockedReason="@(HasOpenTransaction ? "Commit or roll back first" : null)"
                            OnExplainAnalyze="ExplainAnalyze" />
        }
        <MudSelect T="ConnectionModel"
                   Label="Connection"
                   Value="@SelectedConnection"
                   ValueChanged="@OnConnectionChanged"
                   ToStringFunc="@(c => c?.Name ?? string.Empty)"
                   Disabled="@HasOpenTransaction"
                   Margin="Margin.Dense">
            @foreach (var connection in Connections.Connections)
            {
                <MudSelectItem Value="@connection">@connection.Name</MudSelectItem>
            }
        </MudSelect>
        <MudDivider Class="h-100" Vertical="true" DividerType="DividerType.FullWidth"/>
        <MudSelect T="string"
                   Label="Database"
                   Value="@SelectedDatabase"
                   ValueChanged="@OnDatabaseChanged"
                   Disabled="@(SelectedConnection == null || HasOpenTransaction)"
                   Margin="Margin.Dense">
            @if (SelectedConnection != null)
            {
                @foreach (var db in SelectedConnection.Databases)
                {
                    <MudSelectItem Value="@db.Name">@db.Name</MudSelectItem>
                }
            }
        </MudSelect>

        <MudSpacer/>
        
        @if (State?.Active != null)
        {
            <ToggleChip Text="Transactions"
                        Icon="@(State.Active.UseTransaction ? AionIcons.Transaction : AionIcons.TransactionOff)"
                        Disabled="@HasOpenTransaction"
                        DisabledTooltip="Commit or roll back the open transaction to change this"
                        @bind-Value="State.Active.UseTransaction" />

            @if (ShowEstimatedPlanToggle)
            {
                <ToggleChip Text="Estimated Query Plan"
                            Icon="@AionIcons.EstimatedQueryPlan"
                            @bind-Value="State.Active.IncludeEstimatedPlan" />
            }

            @if (ShowActualPlanToggle)
            {
                <ToggleChip Text="Actual Query Plan"
                            Icon="@AionIcons.ActualQueryPlan"
                            @bind-Value="State.Active.IncludeActualPlan" />
            }
        }
    </MudStack>

    @if (State?.Active is { HasOpenTransaction: true } transactionQuery)
    {
        <TransactionBar Query="@transactionQuery" />
    }

    @if (State?.Active?.ResultNotice != null)
    {
        <MudAlert Severity="Severity.Info" Class="my-2">@State.Active.ResultNotice</MudAlert>
    }

    <JsGuard Name="monaco">
        <StandaloneCodeEditor CssClass="h-100 flex-grow-1" @ref="_editor" ConstructionOptions="DefaultOptions" OnDidInit="HandleInit" OnDidChangeModelContent="UpdateQuery" OnDidChangeCursorSelection="SelectionChanged"/>
    </JsGuard>
</MudStack>
@code {
    [Inject] protected QueryState State { get; set; } = default!;
    [Inject] protected ConnectionState Connections { get; set; } = default!;
    [Inject] protected IMessageBus Bus { get; set; } = default!;
    [Inject] protected SqlCompletionService CompletionService { get; set; } = default!;
    [Inject] protected IJSRuntime JS { get; set; } = default!;
    [Inject] protected EditorSettings EditorSettings { get; set; } = default!;
    [Inject] protected AionKeyBindings Keys { get; set; } = default!;
    [Inject] protected ILogger<QueryEditor> Logger { get; set; } = default!;

    private bool _initialized = false;

    private readonly Dictionary<Guid, CancellationTokenSource> _runningQueries = new();

    private const string ErrorMarkerOwner = "aion-query-error";

    // What the editor's error marker currently shows, so edits that don't change it skip the JS call.
    private Guid? _markedQueryId;
    private QueryError? _markedError;

    // Monaco invokes editor actions through a synchronous callback, so requests are queued here and
    // handled by awaited reader loops instead of being fired and forgotten. Runs have a loop of their
    // own so a long statement never holds up the other editor actions.
    private readonly Channel<EditorAction> _editorActions =
        Channel.CreateUnbounded<EditorAction>(new UnboundedChannelOptions { SingleReader = true });
    private readonly Channel<RunRequested> _runRequests =
        Channel.CreateUnbounded<RunRequested>(new UnboundedChannelOptions { SingleReader = true });
    private Task? _editorActionLoop;
    private Task? _runLoop;

    private enum EditorAction
    {
        ExpandSelectStar,
        OpenCommandPalette
    }

    /// <param name="Query">The tab the editor showed when the shortcut was pressed.</param>
    private sealed record RunRequested(QueryModel Query);

    private const string RunQueryActionId = "aion.run-query";

    private bool HasOpenTransaction => State.Active?.HasOpenTransaction ?? false;

    private bool ShowEstimatedPlanToggle => SelectedConnection is not { } connection || Connections.SupportsEstimatedPlan(connection.Type);

    private bool ShowActualPlanToggle => SelectedConnection is not { } connection || Connections.SupportsActualPlan(connection.Type);

    private bool CanExplain => SelectedConnection is { } connection && Connections.SupportsEstimatedPlan(connection.Type);

    private bool CanExplainAnalyze => SelectedConnection is { } connection && Connections.SupportsActualPlan(connection.Type);

    // Kept from the editor's selection events, so the Run selection option knows whether it has anything to run.
    private bool _editorHasSelection;

    private string RunHint(QueryModel query)
    {
        var where = $"{Keys.Describe(Keys.RunQuery)} in the editor";
        return query.IsExecuting ? $"Cancel the run ({where})"
            : _editorHasSelection ? $"Run the selected SQL ({where})"
            : $"Run the query ({where})";
    }

    private ConnectionModel? SelectedConnection => State.Active?.ConnectionId != null 
        ? Connections.Connections.FirstOrDefault(c => c.Id == State.Active.ConnectionId)
        : null;
        
    private string? SelectedDatabase
    {
        get => State.Active?.DatabaseName;
        set
        {
            // Only update if value is different and not null
            // This prevents accidental clearing during re-renders
            if (State.Active != null && value != null && value != State.Active.DatabaseName)
            {
                State.UpdateQueryDatabase(State.Active, value);
            }
        }
    }
    
    private string? RunBlockedReason => State.Active is { } active ? RunBlockedReasonFor(active) : "Choose a connection";

    private string? RunBlockedReasonFor(QueryModel query) =>
        Connections.Connections.All(c => c.Id != query.ConnectionId) ? "Choose a connection"
        : string.IsNullOrEmpty(query.DatabaseName) ? "Choose a database"
        : null;

    private bool CanExecuteQuery => RunBlockedReason == null;
    
    private StandaloneCodeEditor? _editor;

    // The tab whose text the editor holds. It can differ from State.Active for a moment while a tab
    // switch reaches the editor, and typing must land in the tab it was typed into.
    private QueryModel? _shownQuery;

    private StandaloneEditorConstructionOptions DefaultOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "sql",
            FontSize = EditorSettings.FontSize,
            WordWrap = EditorSettings.WordWrap ? "on" : "off",
            LineNumbers = EditorSettings.ShowLineNumbers ? "on" : "off",
            Minimap = new EditorMinimapOptions { Enabled = EditorSettings.ShowMinimap },
            // Monaco measures its container once at creation. The editor pane changes width whenever a side
            // panel opens or closes, and at startup it can be created before the side panel has collapsed.
            AutomaticLayout = true,
            // Shown only while the editor is empty, and never part of the tab's text.
            Placeholder = $"Write a query. {Keys.Describe(Keys.RunQuery)} runs it, {Keys.Describe(Keys.CommandPalette)} opens commands.",
        };
    }

    protected override void OnInitialized()
    {
        State.StateChanged += StateHasChanged;
        State.ActiveQueryTextChanged += RefreshEditor;
        Connections.ConnectionStateChanged += StateHasChanged;
        Bus.Subscribe<FocusQuery>(this);
        Bus.Subscribe<CreateQuery>(this);
        Bus.Subscribe<RunQuery>(this);
        Bus.Subscribe<GoToQueryPosition>(this);
        Bus.Subscribe<SettingsModelChanged<EditorSettings>>(this);

        base.OnInitialized();
    }

    public async ValueTask DisposeAsync()
    {
        State.StateChanged -= StateHasChanged;
        State.ActiveQueryTextChanged -= RefreshEditor;
        Connections.ConnectionStateChanged -= StateHasChanged;
        Bus.Unsubscribe<FocusQuery>(this);
        Bus.Unsubscribe<CreateQuery>(this);
        Bus.Unsubscribe<RunQuery>(this);
        Bus.Unsubscribe<GoToQueryPosition>(this);
        Bus.Unsubscribe<SettingsModelChanged<EditorSettings>>(this);

        _editorActions.Writer.TryComplete();
        _runRequests.Writer.TryComplete();

        // Every cancel is requested before the first await, so no run can finish and dispose its token
        // source in between, and the run loop below isn't left waiting on a long statement.
        await Task.WhenAll(_runningQueries.Values.ToList().Select(running => running.CancelAsync()));

        if (_editorActionLoop != null)
        {
            await _editorActionLoop;
        }

        if (_runLoop != null)
        {
            await _runLoop;
        }
    }

    private void OnConnectionChanged(ConnectionModel? connection)
    {
        if (State.Active != null && connection != null && State.Active.ConnectionId != connection.Id)
        {
            State.UpdateQueryConnection(State.Active, connection);
        }
    }

    private void OnDatabaseChanged(string? database)
    {
        if (State.Active != null && database != null)
        {
            State.UpdateQueryDatabase(State.Active, database);
        }
    }

    private async Task RefreshEditor() => await ShowQueryAsync(State.Active);

    /// <summary>
    /// Puts a tab's text in the editor. Typing reaches the tab through change events that can still be
    /// on their way, so the outgoing tab first takes whatever the editor holds before it is replaced.
    /// </summary>
    private async Task ShowQueryAsync(QueryModel? query)
    {
        if (_editor == null) return;

        if (_shownQuery != null && _shownQuery.Id != query?.Id)
        {
            State.EditQueryText(_shownQuery, await _editor.GetValue());
        }

        _shownQuery = query;
        await _editor.SetValue(query?.Query ?? "");
    }

    private async Task UpdateQuery(ModelContentChangedEvent evt)
    {
        if (!_initialized || _editor == null) return;

        // Taken before the read: a tab switch issued after this line reaches the editor after the read
        // too, so the text read below belongs to this tab.
        var query = _shownQuery;
        var text = await _editor.GetValue();
        if (query != null)
        {
            State.EditQueryText(query, text);
        }

        await RefreshErrorMarkerAsync();
    }

    protected async Task HandleInit()
    {
        await State.InitializeAsync();

        _initialized = true;

        await BlazorMonaco.Languages.Global.RegisterCompletionItemProvider(JS, "sql",
            new CompletionItemProvider(
                new List<string> { " ", ",", "(", "." },
                ProvideSqlCompletionsAsync,
                ResolveSqlCompletionAsync));

        await RefreshEditor();

        _editorActionLoop ??= ProcessEditorActionsAsync();
        _runLoop ??= ProcessRunRequestsAsync();

        // Registered on the editor rather than the page, so the shortcut runs the query only while
        // the editor has focus and never from a dialog or a results grid cell editor. It replaces
        // Monaco's own binding of the same keys (insert line below).
        await _editor!.AddAction(new ActionDescriptor
        {
            Id = RunQueryActionId,
            Label = "Run Query",
            Keybindings = [Keys.RunQuery.EditorKeybinding],
            ContextMenuGroupId = "navigation",
            ContextMenuOrder = 1f,
            Run = _ => RequestRunFromEditor()
        });

        await _editor.AddAction(new ActionDescriptor
        {
            Id = "expand-select-star",
            Label = "Expand SELECT *",
            Keybindings = [Keys.ExpandSelectStar.EditorKeybinding],
            ContextMenuGroupId = "navigation",
            ContextMenuOrder = 1.5f,
            Run = _ => _editorActions.Writer.TryWrite(EditorAction.ExpandSelectStar)
        });

        // Monaco treats Cmd/Ctrl+K as the start of a two-key chord, so the page-level palette hotkey never
        // sees it while the editor has focus.
        await _editor.AddAction(new ActionDescriptor
        {
            Id = "aion.command-palette",
            Label = "Command Palette",
            Keybindings = [Keys.CommandPalette.EditorKeybinding, Keys.CommandPaletteAlternate.EditorKeybinding],
            Run = _ => _editorActions.Writer.TryWrite(EditorAction.OpenCommandPalette)
        });
    }

    private async Task ProcessEditorActionsAsync()
    {
        await foreach (var action in _editorActions.Reader.ReadAllAsync())
        {
            switch (action)
            {
                case EditorAction.ExpandSelectStar:
                    await InvokeAsync(ExpandSelectStarAsync);
                    break;
                case EditorAction.OpenCommandPalette:
                    await Bus.PublishAsync(new OpenCommandPalette());
                    break;
            }
        }
    }

    private void RequestRunFromEditor()
    {
        if (_shownQuery is { } query)
        {
            _runRequests.Writer.TryWrite(new RunRequested(query));
        }
    }

    // A statement can run for minutes, so the loop starts each run and reads on instead of waiting for it:
    // pressing the shortcut again must cancel the run it follows, and a run in another tab must not queue
    // behind it. The runs are still awaited, as they finish or when the loop ends.
    private async Task ProcessRunRequestsAsync()
    {
        var runs = new List<Task>();
        await foreach (var request in _runRequests.Reader.ReadAllAsync())
        {
            runs.RemoveAll(run => run.IsCompletedSuccessfully);
            runs.Add(InvokeAsync(() => RunFromShortcutAsync(request.Query)));
        }

        await Task.WhenAll(runs);
    }

    private async Task RunFromShortcutAsync(QueryModel query)
    {
        try
        {
            await RunQueryAsync(query);
        }
        catch (Exception ex)
        {
            // Query errors are already results; this is the editor itself failing, such as the page closing.
            Logger.LogWarning(ex, "Running the query from the editor shortcut failed");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A tab can become active without the editor being told, such as a clone or a tab closing, so after
        // each render the editor catches up with whichever tab is active.
        if (_initialized && State.Active is { } active && active.Id != _shownQuery?.Id)
        {
            await ShowQueryAsync(active);
            await RefreshErrorMarkerAsync();
        }
    }

    private async Task OnTabChanged(QueryModel query)
    {
        if (_editor != null)
        {
            await ShowQueryAsync(query);
            await RefreshErrorMarkerAsync();
        }
    }

    private async Task<(string Text, Selection Selection)?> GetSelectedTextAsync()
    {
        if (_editor == null) return null;

        var selection = await _editor.GetSelection();
        var hasSelection = selection.StartLineNumber != selection.EndLineNumber
                           || selection.StartColumn != selection.EndColumn;
        if (!hasSelection) return null;

        var model = await _editor.GetModel();
        var text = await model.GetValueInRange(new BlazorMonaco.Range
        {
            StartLineNumber = selection.StartLineNumber,
            StartColumn = selection.StartColumn,
            EndLineNumber = selection.EndLineNumber,
            EndColumn = selection.EndColumn
        }, EndOfLinePreference.TextDefined);

        return (text, selection);
    }

    private QueryModel ShownQuery => _shownQuery ?? State.Active ?? State.Queries.First();

    private async Task RunQuery() => await RunQueryAsync(ShownQuery);

    // Run already takes only the selection when there is one; this option exists so that is discoverable.
    private async Task RunSelection() => await RunQueryAsync(ShownQuery);

    private async Task Explain() => await RunQueryAsync(ShownQuery, QueryRunKind.Explain);

    private async Task ExplainAnalyze() => await RunQueryAsync(ShownQuery, QueryRunKind.ExplainAnalyze);

    // Every cursor move raises this, so it is built without a receiver: the editor re-renders only when
    // having a selection changes, not on each move.
    private EventCallback<CursorSelectionChangedEvent> SelectionChanged =>
        new(null, (Func<CursorSelectionChangedEvent, Task>)OnSelectionChangedAsync);

    private async Task OnSelectionChangedAsync(CursorSelectionChangedEvent change)
    {
        var selection = change.Selection;
        var hasSelection = selection != null
                           && (selection.StartLineNumber != selection.EndLineNumber || selection.StartColumn != selection.EndColumn);
        if (hasSelection == _editorHasSelection) return;

        _editorHasSelection = hasSelection;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Runs the tab's statement, inside its transaction when one is open, or only plans it when
    /// <paramref name="kind"/> asks for a plan. While that tab is executing any run action cancels the
    /// statement; it never ends the transaction, which only the Commit and Rollback buttons do.
    /// </summary>
    private async Task RunQueryAsync(QueryModel query, QueryRunKind kind = QueryRunKind.Execute)
    {
        if (_runningQueries.TryGetValue(query.Id, out var running))
        {
            await running.CancelAsync();
            return;
        }

        using var cancellation = new CancellationTokenSource();
        _runningQueries[query.Id] = cancellation;

        try
        {
            // The editor's text and selection belong to this tab only while the editor shows it.
            var shown = _editor != null && _shownQuery?.Id == query.Id;
            var fullText = shown ? await _editor!.GetValue() : query.Query;
            var selected = shown ? await GetSelectedTextAsync() : null;

            // Typing reaches the tab through the editor's change events; taking the text once more here
            // means the save, the run and the error position all see the same SQL.
            State.EditQueryText(query, fullText);
            await Bus.PublishAsync(new SaveQuery(query));

            // The button explains itself on hover; a shortcut or the palette gets told instead.
            if (RunBlockedReasonFor(query) is { } blocked)
            {
                await Bus.PublishAsync(new AddNotification(blocked, Severity.Info));
                return;
            }

            await ClearErrorMarkerAsync();

            var result = await Connections.ExecuteQueryAsync(query, selected?.Text ?? fullText, kind, cancellation.Token);

            State.SetResult(query, result, selected is { Selection: var selection }
                ? (selection.StartLineNumber, selection.StartColumn)
                : null, sourceText: fullText);

            await RefreshErrorMarkerAsync();
        }
        finally
        {
            _runningQueries.Remove(query.Id);
            StateHasChanged();
        }
    }

    public async Task Consume(FocusQuery message)
    {
        State.SetActive(message.Query);
        await ShowQueryAsync(State.Active);
        StateHasChanged();
    }

    public async Task Consume(CreateQuery message)
    {
        State.AddQuery(message.Name);
        await ShowQueryAsync(State.Active);
    }

    public async Task Consume(RunQuery message)
    {
        await RunQuery();
    }

    public async Task Consume(GoToQueryPosition message)
    {
        if (_editor == null || State.Active?.Id != message.QueryId) return;

        var position = new BlazorMonaco.Position { LineNumber = message.Line, Column = message.Column };
        await _editor.SetPosition(position, "aion-go-to-error");
        await _editor.RevealPositionInCenterIfOutsideViewport(position);
        await _editor.Focus();
    }

    /// <summary>
    /// Marks the active tab's error in the editor while the tab still holds the SQL the error was
    /// reported against, and clears the mark otherwise.
    /// </summary>
    private async Task RefreshErrorMarkerAsync()
    {
        var query = State.Active is { ErrorLocationIsCurrent: true } active ? active : null;
        var error = query?.Result?.ErrorDetail;
        if (query?.Id == _markedQueryId && error == _markedError) return;

        await SetErrorMarkerAsync(query?.Id, error);
    }

    private async Task ClearErrorMarkerAsync()
    {
        if (_markedQueryId == null) return;

        await SetErrorMarkerAsync(null, null);
    }

    private async Task SetErrorMarkerAsync(Guid? queryId, QueryError? error)
    {
        if (_editor == null) return;

        var markers = error is { Line: { } line }
            ? new List<MarkerData>
            {
                new()
                {
                    Severity = MarkerSeverity.Error,
                    Message = error.Message,
                    Source = error.Code,
                    StartLineNumber = line,
                    StartColumn = error.Column ?? 1,
                    EndLineNumber = line,
                    // Monaco clamps the end to the line, so an unknown column marks the whole line.
                    EndColumn = error.EndColumn ?? int.MaxValue,
                    RelatedInformation = [],
                    Tags = []
                }
            }
            : [];

        var model = await _editor.GetModel();
        await BlazorMonaco.Editor.Global.SetModelMarkers(JS, model, ErrorMarkerOwner, markers);

        _markedQueryId = error == null ? null : queryId;
        _markedError = error;
    }

    public async Task Consume(SettingsModelChanged<EditorSettings> message)
    {
        if (_editor == null) return;

        var s = message.Settings;
        await _editor.UpdateOptions(new EditorUpdateOptions
        {
            FontSize = s.FontSize,
            WordWrap = s.WordWrap ? "on" : "off",
            LineNumbers = s.ShowLineNumbers ? "on" : "off",
            Minimap = new EditorMinimapOptions { Enabled = s.ShowMinimap },
        });
    }

    private async Task QueryAddClicked()
    {
        State.AddQuery();
        await ShowQueryAsync(State.Active);
    }

    private async Task ExpandSelectStarAsync()
    {
        try
        {
            if (_editor == null) return;

            var query = State.Active;
            if (query?.ConnectionId == null || query.DatabaseName == null) return;

            var selected = await GetSelectedTextAsync();
            if (selected == null) return;

            var (selectedText, selection) = selected.Value;

            if (!SelectStarExpander.TryParse(selectedText, out var schema, out var table)) return;

            var connection = Connections.Connections.FirstOrDefault(c => c.Id == query.ConnectionId);
            if (connection == null) return;

            var database = connection.Databases.FirstOrDefault(d => d.Name == query.DatabaseName);
            if (database == null) return;

            if (!database.TablesLoaded)
                await Connections.LoadTablesAsync(connection, database);

            var tableInfo = database.Tables.FirstOrDefault(t =>
                t.Name.Equals(table, StringComparison.OrdinalIgnoreCase)
                && (schema == null || t.Schema.Equals(schema, StringComparison.OrdinalIgnoreCase)));

            if (tableInfo == null) return;

            await Connections.LoadColumnsAsync(connection, database, tableInfo.Schema, tableInfo.Name);

            if (!database.TableColumns.TryGetValue(tableInfo.DisplayName, out var columns) || columns.Count == 0) return;

            var columnNames = columns.Select(c => c.Name).ToList();
            var expanded = SelectStarExpander.BuildExpandedSelect(columnNames, schema, table!);

            var edits = new List<IdentifiedSingleEditOperation>
            {
                new()
                {
                    Range = new BlazorMonaco.Range
                    {
                        StartLineNumber = selection.StartLineNumber,
                        StartColumn = selection.StartColumn,
                        EndLineNumber = selection.EndLineNumber,
                        EndColumn = selection.EndColumn
                    },
                    Text = expanded,
                    ForceMoveMarkers = false
                }
            };

            await _editor.ExecuteEdits("expand-select-star", edits, new List<Selection>());
            StateHasChanged();
        }
        catch (Exception)
        {
            // Swallowed: an editor convenience failing (for example on a table that no longer
            // exists) should not end the request loop or surface as an error.
        }
    }
    private async Task<CompletionList> ProvideSqlCompletionsAsync(
        string modelUri, BlazorMonaco.Position position, CompletionContext context)
    {
        try
        {
            var model = await BlazorMonaco.Editor.Global.GetModel(JS, modelUri);
            var word = await model.GetWordUntilPosition(position);
            var range = new BlazorMonaco.Range
            {
                StartLineNumber = position.LineNumber,
                EndLineNumber = position.LineNumber,
                StartColumn = word.StartColumn,
                EndColumn = word.EndColumn
            };

            var editorText = await _editor!.GetValue();
            var line = (int)position.LineNumber - 1;
            var column = (int)position.Column - 1;

            var completions = await CompletionService.GetCompletionsAsync(
                editorText, line, column,
                context.TriggerCharacter,
                State.Active?.ConnectionId,
                State.Active?.DatabaseName);

            var suggestions = completions.Select(item => new CompletionItem
            {
                LabelAsString = item.Label,
                Kind = MapCompletionKind(item.Kind),
                Detail = item.Detail,
                InsertText = item.InsertText ?? item.Label,
                FilterText = item.FilterText,
                SortText = item.SortText,
                RangeAsObject = range
            }).ToList();

            return new CompletionList
            {
                Suggestions = suggestions,
                Incomplete = completions.Count >= 500
            };
        }
        catch
        {
            return new CompletionList { Suggestions = [] };
        }
    }

    private Task<CompletionItem> ResolveSqlCompletionAsync(CompletionItem item)
    {
        return Task.FromResult(item);
    }

    private static CompletionItemKind MapCompletionKind(SqlCompletionKind kind)
    {
        return kind switch
        {
            SqlCompletionKind.Keyword => CompletionItemKind.Keyword,
            SqlCompletionKind.Table => CompletionItemKind.Class,
            SqlCompletionKind.Column => CompletionItemKind.Field,
            SqlCompletionKind.Schema => CompletionItemKind.Module,
            SqlCompletionKind.Function => CompletionItemKind.Function,
            SqlCompletionKind.Procedure => CompletionItemKind.Method,
            _ => CompletionItemKind.Text
        };
    }
}