@using Aion.Components.Connections
@using Aion.Components.Connections.Commands
@using Aion.Components.Shared
@using Aion.Components.Theme
@using Aion.Contracts.Connections
@using Mythetech.Framework.Infrastructure.MessageBus

@*
    One picker for the connection and the database: every connection is a group and its databases are the
    choices, so any database on any connection is one pick away and the list shows both levels at once.
*@
<div class="connection-picker-host">
    <AionMenu Class="connection-picker"
              Disabled="@Disabled"
              AnchorOrigin="Origin.BottomLeft"
              TransformOrigin="Origin.TopLeft"
              MaxHeight="420"
              PopoverClass="connection-picker-popover"
              OpenChanged="OnOpenChanged">
        <ActivatorContent>
            @* Above the button, so it never covers the list that opens below it. *@
            <MudTooltip Text="@TooltipText" RootClass="connection-picker-tooltip" Placement="Placement.Top">
                <span class="connection-picker-trigger" tabindex="-1" @ref="_trigger" @onclick="@(args => context.ToggleAsync(args))">
                    <span class="picker-sr-only">Connection and database: </span>
                    @if (Connection is { } connection)
                    {
                        <span class="picker-names">
                            <span class="picker-connection">@connection.Name</span>
                            @if (ShowsDatabase(connection))
                            {
                                <span class="picker-separator" aria-hidden="true">›</span>
                                <span class="@(Query.DatabaseName == null ? "picker-database picker-missing" : "picker-database")">@(Query.DatabaseName ?? "Choose a database")</span>
                            }
                        </span>
                        <span class="picker-engine">@ConnectionDescription.EngineBadge(connection.Type)</span>
                    }
                    else
                    {
                        <span class="picker-names picker-missing">Choose a connection</span>
                    }
                    <MudIcon Icon="@AionIcons.Picker" Size="Size.Small" Class="picker-caret" />
                </span>
            </MudTooltip>
        </ActivatorContent>
        <ChildContent>
            @foreach (var connection in Connections.Connections)
            {
                <MudListSubheader Class="px-3 pt-2 pb-1">
                    <span class="picker-group">
                        <span class="picker-group-name">@connection.Name</span>
                        <span class="picker-engine">@ConnectionDescription.EngineBadge(connection.Type)</span>
                    </span>
                </MudListSubheader>
                @if (connection.Databases.Count == 0)
                {
                    <MudMenuItem Disabled="true">
                        <span class="picker-option-empty">@(connection.HealthStatus == ConnectionHealthStatus.Checking ? "Loading databases" : "No databases")</span>
                    </MudMenuItem>
                }
                @foreach (var database in connection.Databases)
                {
                    var chosen = IsChosen(connection, database.Name);
                    <MudMenuItem OnClick="@(() => Choose(connection, database.Name))" aria-current="@(chosen ? "true" : null)">
                        <span class="picker-option">
                            <span class="picker-option-name">@database.Name</span>
                            @if (chosen)
                            {
                                <MudIcon Icon="@AionIcons.Accept" Size="Size.Small" Class="picker-option-check" />
                            }
                        </span>
                    </MudMenuItem>
                }
            }
            @if (Connections.Connections.Count > 0)
            {
                <MudDivider Class="my-1" />
            }
            <MudMenuItem Icon="@AionIcons.Add" OnClick="NewConnection">New connection</MudMenuItem>
        </ChildContent>
    </AionMenu>
</div>

@code {
    [Inject] protected ConnectionState Connections { get; set; } = default!;
    [Inject] protected QueryState State { get; set; } = default!;
    [Inject] protected IMessageBus Bus { get; set; } = default!;

    /// <summary>The tab whose connection and database this picks.</summary>
    [Parameter, EditorRequired] public QueryModel Query { get; set; } = default!;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Why the connection can't change right now, shown on hover while disabled.</summary>
    [Parameter] public string? DisabledReason { get; set; }

    private ElementReference _trigger;

    private ConnectionModel? Connection => Connections.Connections.FirstOrDefault(c => c.Id == Query.ConnectionId);

    // The menu hands focus back only to activators it draws itself, so without this a keyboard user who
    // picks a database or presses Escape is left on the page body.
    private async Task OnOpenChanged(bool open)
    {
        if (!open)
        {
            await _trigger.FocusAsync();
        }
    }

    // A connection with a single database is that database, so naming it again only costs width.
    private bool ShowsDatabase(ConnectionModel connection) =>
        !(connection.Databases.Count == 1 && connection.Databases[0].Name == Query.DatabaseName);

    private bool IsChosen(ConnectionModel connection, string database) =>
        connection.Id == Query.ConnectionId && database == Query.DatabaseName;

    // Always shown rather than only when the names are cut short: it also says which server the tab runs on.
    private string TooltipText => Disabled && DisabledReason != null ? DisabledReason
        : Connection is { } connection ? $"{FullNames(connection)} · {ConnectionDescription.Describe(connection)}"
        : "Choose the connection and database this tab runs on";

    private string FullNames(ConnectionModel connection) => Query.DatabaseName switch
    {
        null => $"{connection.Name} › no database chosen",
        var database when database == connection.Name => connection.Name,
        var database => $"{connection.Name} › {database}"
    };

    private void Choose(ConnectionModel connection, string database)
    {
        if (IsChosen(connection, database)) return;

        State.UpdateQueryConnection(Query, connection, database);
    }

    private async Task NewConnection() => await Bus.PublishAsync(new PromptCreateConnection());
}
