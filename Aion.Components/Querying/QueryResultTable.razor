@using Mythetech.Framework.Components.Buttons
@using Aion.Components.Querying.Commands
@using Aion.Components.Querying.Consumers
@using Aion.Components.Querying.Editing
@using Aion.Components.Querying.Results
@using Aion.Components.RequestContextPanel
@using Aion.Components.RequestContextPanel.Commands
@using Aion.Components.Settings.Domains
@using Aion.Components.Shared
@using Aion.Components.Shared.Snackbar.Commands
@using Aion.Components.Theme
@using Aion.Contracts.Database
@using Aion.Contracts.Queries
@using Microsoft.JSInterop
@using System.Text.Json
@using MudBlazor.Services
@using MudBlazor.State
@using Mythetech.Framework.Infrastructure.MessageBus
@inherits ComponentBaseWithState
@implements IAsyncDisposable

<div class="result-grid" id="@_gridId">
<MudDataGrid T="ResultRow"
             Items="@_shownRows"
             Dense="true"
             Hover="true"
             Filterable="false"
             SortMode="SortMode.None"
             ShowColumnOptions="false"
             Virtualize="true"
             ItemSize="@RowHeight"
             OverscanCount="20"
             ColumnResizeMode="ResizeMode.Container"
             RowClassFunc="@RowClass"
             RowContextMenuClick="@OpenRowMenuAsync"
             Class="query-result-table">
    <Columns>
        @* A checkbox and the row's number, one control, so rows are picked the same way while reading and while
           editing, where clicking a cell edits it. *@
        <TemplateColumn T="ResultRow"
                        Title=""
                        Sortable="false"
                        Filterable="false"
                        Resizable="false"
                        HeaderClass="row-select-header"
                        CellClass="row-select-cell">
            <HeaderTemplate>
                @{
                    var coverage = SelectionState.CoverageOf(_view.Order);
                }
                <button type="button"
                        class="row-select-all"
                        role="checkbox"
                        aria-checked="@AriaChecked(coverage)"
                        aria-label="@SelectAllLabel"
                        title="@(coverage == SelectionCoverage.All ? "Clear selection" : SelectAllLabel)"
                        @onclick="ToggleSelectAll">
                    <MudIcon Icon="@CheckboxIcon(coverage)" Class="row-check" />
                </button>
            </HeaderTemplate>
            <CellTemplate>
                @{
                    var rowIndex = context.Item.Index;
                    var selected = SelectionState.IsSelected(rowIndex);
                    var number = _view.PositionOf(rowIndex) + 1;
                }
                <button @ref="_selectElements[rowIndex]"
                        type="button"
                        class="row-select"
                        role="checkbox"
                        aria-checked="@(selected ? "true" : "false")"
                        aria-label="@($"Select row {number}")"
                        @onclick="@(e => HandleRowSelectClick(rowIndex, e))">
                    <MudIcon Icon="@(selected ? AionIcons.Checked : AionIcons.Unchecked)" Class="row-check" />
                    <span class="row-number">@number</span>
                </button>
            </CellTemplate>
        </TemplateColumn>

        @* Data columns *@
        @foreach (var column in _columns)
        {
            var col = column.Key;
            var direction = _sortState.Value?.Key == col ? _sortState.Value.Direction : (ResultSortDirection?)null;
            <TemplateColumn T="ResultRow" Title="@column.Header" Resizable="true" Sortable="false"
                            CellClassFunc="@(row => EditCellClass(row, col))">
                <HeaderTemplate>
                    <button type="button"
                            class="column-heading @(column.IsNumeric ? "numeric" : null)"
                            aria-label="@SortLabel(column.Header, direction)"
                            title="@SortLabel(column.Header, direction)"
                            @onclick="@(() => ToggleSort(col))">
                        <span class="column-name-line">
                            <span class="column-name @(column.Name.Length == 0 ? "unnamed" : null)">@column.Header</span>
                            @if (direction is { } sortDirection)
                            {
                                <MudIcon Icon="@(sortDirection == ResultSortDirection.Ascending ? AionIcons.SortAscending : AionIcons.SortDescending)"
                                         Class="column-sort-icon" />
                            }
                        </span>
                        @if (column.TypeLabel.Length > 0)
                        {
                            <span class="column-type">@column.TypeLabel</span>
                        }
                    </button>
                </HeaderTemplate>
                <CellTemplate>
                    @if (IsEditing)
                    {
                        @EditCell(context.Item, column)
                    }
                    else
                    {
                        var value = context.Item.Values.GetValueOrDefault(col);
                        var rowIndex = context.Item.Index;
                        var foreignKey = value is not null && IsForeignKeyColumn(col, out var reference) ? reference : null;
                        <div class="cell-content @(column.IsNumeric ? "numeric" : null) @(foreignKey is null ? null : "cell-fk-value")"
                             @oncontextmenu="@(() => NoteRightClickedCell(rowIndex, col))"
                             @onclick="@(e => HandleCellClick(rowIndex, e))">
                            @if (value != null && value.ToString()!.StartsWith('{') && value.ToString()!.EndsWith('}'))
                            {
                                <MudLink Class="cell-link"
                                         OnClick="@(async () => await OpenJsonDetailView(col, value.ToString()!))">
                                    @value
                                </MudLink>
                            }
                            else if (value is null)
                            {
                                <span class="cell-null">NULL</span>
                            }
                            else
                            {
                                @CellValue(value, column)
                            }
                            @if (foreignKey is not null)
                            {
                                @ForeignKeyLink(context.Item, col, foreignKey, value!)
                            }
                        </div>
                    }
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
</MudDataGrid>
</div>
@if (_shownRows.Count < _view.Count)
{
    <div class="result-limit-bar">
        <span>Showing @_shownRows.Count.ToString("N0") of @_view.Count.ToString("N0") @(_view.IsFiltered ? "matching rows" : "rows")</span>
        <MtButton Class="result-load-more" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="LoadMore">
            Load @Math.Min(RowLimit, _view.Count - _shownRows.Count).ToString("N0") more
        </MtButton>
        <MtButton Class="result-show-all" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="ShowAll">
            Show all
        </MtButton>
    </div>
}

@* Right-clicking anywhere on a row opens its menu at the pointer. It acts on that row, and on the selection too when
   the row is part of it. *@
<AionMenu @ref="_contextMenu"
          AnchorOrigin="Origin.BottomLeft"
          TransformOrigin="Origin.TopLeft"
          PositionAtCursor="true"
          OpenChanged="OnRowMenuOpenChanged">
    <ChildContent>
        @if (_contextRow is { } row)
        {
            var column = _contextColumn;
            var selected = SelectionState.IsSelected(row.Index);
            var selection = selected ? SelectedShownRows() : [];
            <ContextMenuFocus OnEscape="CloseRowMenuWithKeyboardAsync">
                @if (column != null)
                {
                    <MudMenuItem Icon="@AionIcons.Copy" Disabled="@(ResultValueFormatter.Full(row.Values.GetValueOrDefault(column)) is null)" OnClick="@(() => CopyCellAsync(row, column))">
                        Copy cell
                    </MudMenuItem>
                }
                <MudMenuItem Icon="@AionIcons.Copy" OnClick="@(() => CopyRowAsync(row, "Csv"))">
                    Copy row
                </MudMenuItem>
                <MudMenuItem Icon="@AionIcons.Json" OnClick="@(() => CopyRowAsync(row, "Json"))">
                    Copy row as JSON
                </MudMenuItem>
                @if (selection.Count > 1)
                {
                    <MudMenuItem Icon="@AionIcons.CopyRows" OnClick="@(() => CopyRowsAsync(selection))">
                        Copy @selection.Count selected rows
                    </MudMenuItem>
                }

                @if (IsEditing)
                {
                    <MudDivider />
                    @if (column != null && CanSetCellNull(row, column))
                    {
                        <MudMenuItem Icon="@AionIcons.SetNull" OnClick="@(() => FromMenu(() => SetCell(row, column, null)))">
                            Set cell to NULL
                        </MudMenuItem>
                    }
                    @if (column != null && Edits!.IsCellModified(row.Index, column))
                    {
                        <MudMenuItem Icon="@AionIcons.Undo" OnClick="@(() => FromMenu(() => SetCell(row, column, row.Values.GetValueOrDefault(column))))">
                            Revert cell
                        </MudMenuItem>
                    }
                    @if (IsRowDeleted(row.Index))
                    {
                        var restore = selection.Where(r => IsRowDeleted(r.Index)).ToList();
                        <MudMenuItem Icon="@AionIcons.Restore" IconColor="Color.Success" OnClick="@(() => FromMenu(() => RestoreRows(restore.Count > 1 ? restore : [row])))">
                            @(restore.Count > 1 ? $"Restore {restore.Count} selected rows" : "Restore row")
                        </MudMenuItem>
                    }
                    else
                    {
                        var delete = selection.Where(r => !IsRowDeleted(r.Index)).ToList();
                        <MudMenuItem Icon="@AionIcons.Delete" IconColor="Color.Error" OnClick="@(() => FromMenu(() => DeleteRows(delete.Count > 1 ? delete : [row])))">
                            @(delete.Count > 1 ? $"Delete {delete.Count} selected rows" : "Delete row")
                        </MudMenuItem>
                    }
                }

                <MudDivider />
                <MudMenuItem Icon="@(selected ? AionIcons.Unchecked : AionIcons.Checked)" OnClick="@(() => FromMenu(() => SelectionState.ToggleRow(row.Index, shiftKey: false, _view.Order)))">
                    @(selected ? "Deselect row" : "Select row")
                </MudMenuItem>
                <MudMenuItem Icon="@AionIcons.ViewJson" OnClick="@(() => ViewRowAsJsonAsync(row))">
                    View row as JSON
                </MudMenuItem>
                @foreach (var link in RelatedRows(row))
                {
                    <MudMenuItem Icon="@AionIcons.ForeignKey" OnClick="@(() => OpenForeignKeyFromMenuAsync(link, row))">
                        @link.Label
                    </MudMenuItem>
                }

                @if (selection.Count > 0)
                {
                    var exported = selection.Count == 1 ? "selected row" : $"{selection.Count} selected rows";
                    <MudDivider />
                    <MudMenuItem Icon="@AionIcons.Csv" OnClick="@(() => ExportRowsAsync(selection, "Csv"))">
                        Export @exported to CSV
                    </MudMenuItem>
                    <MudMenuItem Icon="@AionIcons.Json" OnClick="@(() => ExportRowsAsync(selection, "Json"))">
                        Export @exported to JSON
                    </MudMenuItem>
                    <MudMenuItem Icon="@AionIcons.Spreadsheet" OnClick="@(() => ExportRowsAsync(selection, "Excel"))">
                        Export @exported to Excel
                    </MudMenuItem>
                }
            </ContextMenuFocus>
        }
    </ChildContent>
</AionMenu>

@code {
    [Parameter] public required QueryResult Result { get; set; }
    [Parameter] public required string QueryName { get; set; }
    [Parameter] public string? SearchFilter { get; set; }

    /// <summary>
    /// The column the rows are sorted by, which the host binds so what it exports follows the grid's order.
    /// </summary>
    [Parameter] public ResultSort? Sort { get; set; }

    [Parameter] public EventCallback<ResultSort?> SortChanged { get; set; }

    [Parameter] public RowSelectionState SelectionState { get; set; } = new();
    [Parameter] public EditState? EditState { get; set; }
    [Parameter] public QueryEditMetadata? EditMetadata { get; set; }
    [Parameter] public Guid? ConnectionId { get; set; }
    [Parameter] public string? DatabaseName { get; set; }
    [Parameter] public DatabaseType DatabaseType { get; set; }

    [Inject] protected IMessageBus Bus { get; set; } = default!;
    [Inject] protected ResultsSettings ResultsSettings { get; set; } = default!;
    [Inject] private IKeyInterceptorService KeyInterceptor { get; set; } = default!;

    private const int RowHeight = 28;

    // Values longer than this may be cut short by the column, so their cell carries the full text as a title.
    private const int LongValueLength = 40;

    private readonly string _gridId = $"result-grid-{Guid.NewGuid():N}";

    private AionMenu? _contextMenu;

    // The row the menu is open on, and the cell within it when the right-click landed on one.
    private ResultRow? _contextRow;
    private string? _contextColumn;
    private bool _rowMenuOpen;

    // A right-click reaches the cell before its row, so the cell notes itself here for the row's menu to pick up.
    private (int Row, string Column)? _rightClickedCell;

    private EditState? _subscribedEditState;

    // Edit mode: the cell being edited, the cell keyboard focus is on, and each rendered cell so focus can move to it.
    private CellEditSession? _editSession;
    private (int Row, string Column)? _activeCell;
    private bool _focusActiveCell;
    private readonly Dictionary<(int Row, string Column), ElementReference> _cellElements = [];

    // Each rendered row's checkbox, where focus returns when the row's menu closes and no cell can take it.
    private readonly Dictionary<int, ElementReference> _selectElements = [];
    private int? _focusRowCheckbox;

    private QueryEditMetadata? _rulesMetadata;
    private readonly Dictionary<string, EditableColumn> _columnRules = [];

    private QueryResult? _viewResult;
    private IReadOnlyList<ResultGridColumn> _columns = [];
    private IReadOnlyList<ResultRow> _rows = [];
    private ResultGridView _view = ResultGridView.Empty;
    private IReadOnlyList<ResultRow> _shownRows = [];
    private int _shownLimit;
    private readonly ParameterState<ResultSort?> _sortState;

    // What the view was last built from. Sorting from a header builds it at once, and a host bound to the sort
    // then hands the same sort back, which must not sort every row a second time.
    private (IReadOnlyList<ResultRow> Rows, string? Filter, ResultSort? Sort)? _viewInputs;

    public QueryResultTable()
    {
        // One handler for all three, so a new result that arrives with a new filter or sort builds the view once.
        using var registerScope = CreateRegisterScope();
        registerScope.RegisterParameter<QueryResult>(nameof(Result))
            .WithParameter(() => Result)
            .WithChangeHandler(OnViewInputsChanged);
        registerScope.RegisterParameter<string?>(nameof(SearchFilter))
            .WithParameter(() => SearchFilter)
            .WithChangeHandler(OnViewInputsChanged);
        _sortState = registerScope.RegisterParameter<ResultSort?>(nameof(Sort))
            .WithParameter(() => Sort)
            .WithEventCallback(() => SortChanged)
            .WithChangeHandler(OnViewInputsChanged);
    }

    private int RowLimit => ResultsSettings.EffectiveRowLimit;

    private async Task OnViewInputsChanged()
    {
        if (!ReferenceEquals(_viewResult, Result))
        {
            _viewResult = Result;
            _columns = ResultGridColumn.From(Result, DatabaseType);
            _rows = ResultRow.Wrap(Result.Rows);
            _shownLimit = RowLimit;

            // Cells are identified by their row's place in the result, which means nothing in a new result.
            _editSession = null;
            _activeCell = null;
            _cellElements.Clear();
            _selectElements.Clear();

            // Running the query again keeps its sort; a result without that column starts unsorted.
            if (_sortState.Value is { } sort && !Result.Columns.Contains(sort.Key))
            {
                await _sortState.SetValueAsync(null);
            }
        }

        RebuildView();
        StateHasChanged();
    }

    private void RebuildView()
    {
        var inputs = (_rows, SearchFilter, _sortState.Value);
        if (_viewInputs == inputs)
        {
            return;
        }

        _viewInputs = inputs;
        _view = ResultGridView.Build(_rows, SearchFilter, _sortState.Value);
        _shownRows = _view.Take(_shownLimit);
    }

    private async Task ToggleSort(string column)
    {
        await _sortState.SetValueAsync(ResultSort.Next(_sortState.Value, column));
        RebuildView();
    }

    private static string SortLabel(string column, ResultSortDirection? direction) => direction switch
    {
        ResultSortDirection.Ascending => $"{column}, sorted ascending. Sort descending",
        ResultSortDirection.Descending => $"{column}, sorted descending. Clear sort",
        _ => $"{column}. Sort ascending"
    };

    private void LoadMore()
    {
        _shownLimit += RowLimit;
        _shownRows = _view.Take(_shownLimit);
    }

    private void ShowAll()
    {
        _shownLimit = int.MaxValue;
        _shownRows = _view.Rows;
    }

    protected override void OnParametersSet()
    {
        // Each edit session has its own EditState, so follow the parameter instead of the first instance seen.
        var edits = Edits;
        if (!ReferenceEquals(_subscribedEditState, edits))
        {
            if (_subscribedEditState != null)
            {
                _subscribedEditState.StateChanged -= OnEditStateChanged;
            }

            if (edits != null)
            {
                edits.StateChanged += OnEditStateChanged;
            }

            _subscribedEditState = edits;
            _editSession = null;
        }

        base.OnParametersSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Arrow keys and Space would scroll the grid while they move between cells or start an edit, and
            // Ctrl/Cmd+0 would reset the browser's zoom instead of setting a cell to NULL.
            await KeyInterceptor.SubscribeAsync(_gridId,
                new KeyInterceptorOptions("cell-nav",
                    new KeyOptions("ArrowUp", preventDown: "key+none"),
                    new KeyOptions("ArrowDown", preventDown: "key+none"),
                    new KeyOptions("ArrowLeft", preventDown: "key+none"),
                    new KeyOptions("ArrowRight", preventDown: "key+none"),
                    new KeyOptions(" ", preventDown: "key+none"),
                    new KeyOptions("0", preventDown: "key+ctrl|key+meta")),
                keyDown: (Func<KeyboardEventArgs, Task>?)null);
        }

        if (_focusActiveCell && _editSession == null && _activeCell is { } active)
        {
            _focusActiveCell = false;
            if (_cellElements.TryGetValue(active, out var element))
            {
                await FocusIfShownAsync(element);
            }
        }

        if (_focusRowCheckbox is { } row)
        {
            _focusRowCheckbox = null;
            if (_selectElements.TryGetValue(row, out var checkbox))
            {
                await FocusIfShownAsync(checkbox);
            }
        }
    }

    private static async Task FocusIfShownAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (JSException)
        {
            // The element's row scrolled out of view and was removed, so there is nothing to focus.
        }
    }

    private void OnEditStateChanged()
    {
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribedEditState != null)
        {
            _subscribedEditState.StateChanged -= OnEditStateChanged;
        }

        await KeyInterceptor.UnsubscribeAsync(_gridId);
    }

    // The table's own pending changes, from the metadata when the host doesn't pass them separately.
    private EditState? Edits => EditState ?? (EditMetadata?.IsEditMode == true ? EditMetadata.EditState : null);

    private bool IsEditing => EditMetadata?.IsEditMode == true && Edits != null;

    private bool IsRowDeleted(int rowIndex) =>
        Edits?.IsRowDeleted(rowIndex) == true;

    private EditableColumn RulesFor(string column)
    {
        if (!ReferenceEquals(_rulesMetadata, EditMetadata))
        {
            _rulesMetadata = EditMetadata;
            _columnRules.Clear();
        }

        if (!_columnRules.TryGetValue(column, out var rules))
        {
            rules = EditableColumn.For(column, EditMetadata?.ColumnMetadata ?? [], DatabaseType);
            _columnRules[column] = rules;
        }

        return rules;
    }

    private bool CanEditCell(ResultRow row, string column) =>
        IsEditing
        && !IsRowDeleted(row.Index)
        && RulesFor(column).IsEditable
        && CellEditText.CanEdit(row.Values.GetValueOrDefault(column));

    private bool IsEditingCell(int rowIndex, string column) =>
        _editSession is { } session && session.RowIndex == rowIndex && session.Column == column;

    // With no cell focused yet, the first cell is where Tab enters the grid.
    private bool IsTabStop(int rowIndex, string column) => _activeCell is { } active
        ? active.Row == rowIndex && active.Column == column
        : _shownRows.Count > 0 && _columns.Count > 0 && _shownRows[0].Index == rowIndex && _columns[0].Key == column;

    private string EditCellClass(ResultRow row, string column)
    {
        if (!IsEditing)
        {
            return string.Empty;
        }

        if (IsEditingCell(row.Index, column))
        {
            return "cell-editing";
        }

        return Edits!.IsCellModified(row.Index, column) ? "cell-modified" : string.Empty;
    }

    private string? ReadOnlyReason(ResultRow row, string column)
    {
        if (IsRowDeleted(row.Index))
        {
            return "This row will be deleted. Restore it to edit it.";
        }

        var rules = RulesFor(column);
        if (!rules.IsEditable)
        {
            return rules.ReadOnlyReason;
        }

        return CellEditText.CanEdit(row.Values.GetValueOrDefault(column)) ? null : "Binary values can't be edited as text";
    }

    private RenderFragment EditCell(ResultRow row, ResultGridColumn column) => __builder =>
    {
        var col = column.Key;
        var rowIndex = row.Index;

        if (_editSession is { } session && IsEditingCell(rowIndex, col))
        {
            <GridCellEditor @key="session"
                            Session="@session"
                            ColumnName="@column.Header"
                            IsNumeric="@column.IsNumeric"
                            OnCommit="@(move => CommitEdit(session, move))"
                            OnCancel="@(() => CancelEdit(session))" />
        }
        else
        {
            var readOnlyReason = ReadOnlyReason(row, col);
            <div @ref="_cellElements[(rowIndex, col)]"
                 class="cell-content cell-nav @(column.IsNumeric ? "numeric" : null) @(readOnlyReason is null ? null : "cell-readonly")"
                 tabindex="@(IsTabStop(rowIndex, col) ? 0 : -1)"
                 title="@readOnlyReason"
                 @onclick="@(() => OnEditCellClick(row, col))"
                 @onfocus="@(() => _activeCell = (rowIndex, col))"
                 @onkeydown="@(e => OnEditCellKeyDown(e, row, col))"
                 @oncontextmenu="@(() => NoteRightClickedCell(rowIndex, col))">
                @EditCellValue(row, column)
            </div>
        }
    };

    // A changed cell shows its new value with the original struck through, so the change is visible where it was made.
    private RenderFragment EditCellValue(ResultRow row, ResultGridColumn column) => __builder =>
    {
        var col = column.Key;
        var original = row.Values.GetValueOrDefault(col);
        var modified = Edits!.IsCellModified(row.Index, col);
        var value = modified ? Edits.GetEffectiveValue(row.Index, col, row.Values) : original;

        if (value is null)
        {
            <span class="cell-null">NULL</span>
        }
        else if (modified && value is string { Length: 0 })
        {
            <span class="cell-empty">empty</span>
        }
        else
        {
            @CellValue(value, column)
        }

        if (modified)
        {
            var was = original is null ? "NULL" : ResultValueFormatter.Display(original, column.Type);
            <s class="cell-original" title="@($"Was {was}")">@was</s>
        }

        if (value is not null && IsForeignKeyColumn(col, out var foreignKey))
        {
            @ForeignKeyLink(row, col, foreignKey!, value)
        }
    };

    // Opens the row a foreign key value references. Only rows from one known table carry the column metadata
    // that says which columns are foreign keys, whether they are being edited or only read.
    private RenderFragment ForeignKeyLink(ResultRow row, string column, ForeignKeyInfo foreignKey, object value) => __builder =>
    {
        <button type="button"
                class="cell-fk"
                aria-label="@($"Show {column} reference")"
                title="@($"Show {foreignKey.ReferencedTable} row")"
                @onclick="@(() => OpenForeignKeyView(column, foreignKey, value, row))"
                @onclick:stopPropagation="true">
            <MudIcon Icon="@AionIcons.ForeignKey" Size="Size.Small" />
        </button>
    };

    private RenderFragment CellValue(object value, ResultGridColumn column) => __builder =>
    {
        var shown = ResultValueFormatter.Display(value, column.Type);
        var full = ResultValueFormatter.Full(value);
        <span class="cell-value" title="@(shown == full && shown?.Length <= LongValueLength ? null : full)">@shown</span>
    };

    // Clicking a cell edits it, so rows are selected only from their row numbers.
    private void OnEditCellClick(ResultRow row, string column)
    {
        if (_editSession is { } open && !IsEditingCell(row.Index, column))
        {
            // The editor's blur normally commits it before this click; this covers a click that arrives first.
            EndEdit(open);
        }

        if (CanEditCell(row, column))
        {
            BeginEdit(row, column);
        }
        else
        {
            FocusCell(row.Index, column);
        }
    }

    private void OnEditCellKeyDown(KeyboardEventArgs e, ResultRow row, string column)
    {
        switch (e.Key)
        {
            case "ArrowUp":
                MoveFocus(row.Index, column, CellEditMove.Up);
                break;
            case "ArrowDown":
                MoveFocus(row.Index, column, CellEditMove.Down);
                break;
            case "ArrowLeft":
                MoveFocus(row.Index, column, CellEditMove.Left);
                break;
            case "ArrowRight":
                MoveFocus(row.Index, column, CellEditMove.Right);
                break;
            case "Enter" or "F2" when CanEditCell(row, column):
                BeginEdit(row, column);
                break;
            case "0" when (e.CtrlKey || e.MetaKey) && CanEditCell(row, column) && RulesFor(column).IsNullable:
                SetCell(row, column, null);
                break;
            case { Length: 1 } when !e.CtrlKey && !e.MetaKey && !e.AltKey && CanEditCell(row, column):
                BeginEdit(row, column, typed: e.Key);
                break;
        }
    }

    private void BeginEdit(ResultRow row, string column, string? typed = null)
    {
        var current = Edits!.GetEffectiveValue(row.Index, column, row.Values);
        var text = typed ?? CellEditText.From(current, ColumnType(column));
        _editSession = new CellEditSession(row.Index, column, text, RulesFor(column), selectOnOpen: typed is null);
        _activeCell = (row.Index, column);
    }

    private void CommitEdit(CellEditSession session, CellEditMove move)
    {
        if (!ReferenceEquals(session, _editSession))
        {
            return;
        }

        EndEdit(session);

        if (move is CellEditMove.Next or CellEditMove.Previous)
        {
            if (NextEditableCell(session.RowIndex, session.Column, move == CellEditMove.Next) is { } next)
            {
                BeginEdit(next.Row, next.Column);
                return;
            }

            move = CellEditMove.None;
        }

        MoveFocus(session.RowIndex, session.Column, move);
    }

    private void CancelEdit(CellEditSession session)
    {
        if (!ReferenceEquals(session, _editSession))
        {
            return;
        }

        _editSession = null;
        FocusCell(session.RowIndex, session.Column);
    }

    // Commits what the session holds when that is a value the column takes, and closes the editor either way.
    private void EndEdit(CellEditSession session)
    {
        _editSession = null;
        if (session.TryGetCommitText(out var text) && session.RowIndex < _rows.Count)
        {
            var row = _rows[session.RowIndex];
            SetCell(row, session.Column, CellEditText.Resolve(text, row.Values.GetValueOrDefault(session.Column), ColumnType(session.Column), session.Rules));
        }
    }

    private void SetCell(ResultRow row, string column, object? value) =>
        Edits?.UpdateCell(row.Index, column, value, row.Values);

    private string? ColumnType(string column) => _columns.FirstOrDefault(c => c.Key == column)?.Type;

    private void FocusCell(int rowIndex, string column)
    {
        _activeCell = (rowIndex, column);
        _focusActiveCell = true;
    }

    private void MoveFocus(int rowIndex, string column, CellEditMove move)
    {
        var columnIndex = ColumnIndex(column);
        var position = _view.PositionOf(rowIndex);
        if (columnIndex < 0 || position < 0)
        {
            return;
        }

        (position, columnIndex) = move switch
        {
            CellEditMove.Up => (Math.Max(position - 1, 0), columnIndex),
            CellEditMove.Down => (Math.Min(position + 1, _shownRows.Count - 1), columnIndex),
            CellEditMove.Left => (position, Math.Max(columnIndex - 1, 0)),
            CellEditMove.Right => (position, Math.Min(columnIndex + 1, _columns.Count - 1)),
            _ => (position, columnIndex)
        };

        FocusCell(_shownRows[position].Index, _columns[columnIndex].Key);
    }

    // Tab walks the editable cells row by row, the way a form's fields go, skipping keys and deleted rows.
    private (ResultRow Row, string Column)? NextEditableCell(int rowIndex, string column, bool forward)
    {
        var step = forward ? 1 : -1;
        var position = _view.PositionOf(rowIndex);
        var columnIndex = ColumnIndex(column) + step;

        while (position >= 0 && position < _shownRows.Count)
        {
            var row = _shownRows[position];
            for (; columnIndex >= 0 && columnIndex < _columns.Count; columnIndex += step)
            {
                if (CanEditCell(row, _columns[columnIndex].Key))
                {
                    return (row, _columns[columnIndex].Key);
                }
            }

            position += step;
            columnIndex = forward ? 0 : _columns.Count - 1;
        }

        return null;
    }

    private int ColumnIndex(string column)
    {
        for (var i = 0; i < _columns.Count; i++)
        {
            if (_columns[i].Key == column)
            {
                return i;
            }
        }

        return -1;
    }

    private bool CanSetCellNull(ResultRow row, string column) =>
        CanEditCell(row, column)
        && RulesFor(column).IsNullable
        && Edits!.GetEffectiveValue(row.Index, column, row.Values) != null;

    private void DeleteRows(IReadOnlyList<ResultRow> rows)
    {
        foreach (var row in rows)
        {
            Edits?.DeleteRow(row.Index, row.Values);
        }
    }

    private void RestoreRows(IReadOnlyList<ResultRow> rows)
    {
        foreach (var row in rows)
        {
            Edits?.UndeleteRow(row.Index);
        }
    }

    private void HandleCellClick(int rowIndex, MouseEventArgs e)
    {
        SelectionState.ToggleSelection(rowIndex, e.CtrlKey || e.MetaKey, e.ShiftKey, _view.Order);
    }

    // A checkbox toggles its row whether or not Ctrl or Cmd is held, so only Shift changes what a click does.
    private void HandleRowSelectClick(int rowIndex, MouseEventArgs e)
    {
        SelectionState.ToggleRow(rowIndex, e.ShiftKey, _view.Order);
    }

    private string SelectAllLabel => _view.IsFiltered ? "Select all matching rows" : "Select all rows";

    private void ToggleSelectAll()
    {
        if (SelectionState.CoverageOf(_view.Order) == SelectionCoverage.All)
        {
            SelectionState.ClearSelection();
        }
        else
        {
            SelectionState.SelectAll(_view.Order);
        }
    }

    private static string AriaChecked(SelectionCoverage coverage) => coverage switch
    {
        SelectionCoverage.All => "true",
        SelectionCoverage.Some => "mixed",
        _ => "false"
    };

    private static string CheckboxIcon(SelectionCoverage coverage) => coverage switch
    {
        SelectionCoverage.All => AionIcons.Checked,
        SelectionCoverage.Some => AionIcons.PartlyChecked,
        _ => AionIcons.Unchecked
    };

    private string? RowClass(ResultRow row, int position)
    {
        var selected = SelectionState.IsSelected(row.Index) ? "row-selected" : null;
        var edit = Edits switch
        {
            { } edits when edits.IsRowDeleted(row.Index) => "row-deleted",
            { } edits when edits.IsRowInserted(row.Index) => "row-inserted",
            _ => null
        };
        var context = _rowMenuOpen && _contextRow?.Index == row.Index ? "row-context" : null;

        var classes = string.Join(' ', new[] { selected, edit, context }.Where(c => c != null));
        return classes.Length > 0 ? classes : null;
    }

    // Only notes the cell. The row's handler runs next and opens the menu, so a right-click anywhere on the row,
    // its checkbox and cell padding included, opens it.
    private void NoteRightClickedCell(int rowIndex, string column) => _rightClickedCell = (rowIndex, column);

    private async Task OpenRowMenuAsync(DataGridRowClickEventArgs<ResultRow> args)
    {
        var row = args.Item;
        _contextRow = row;
        _contextColumn = _rightClickedCell is { } cell && cell.Row == row.Index ? cell.Column : null;
        _rightClickedCell = null;

        if (_contextMenu != null)
        {
            await _contextMenu.OpenMenuAsync(args.MouseEventArgs);
        }
    }

    private void OnRowMenuOpenChanged(bool open) => _rowMenuOpen = open;

    private async Task CloseRowMenuWithKeyboardAsync()
    {
        if (_contextMenu != null)
        {
            await _contextMenu.CloseMenuAsync();
        }

        ReturnFocusToContextRow();
    }

    // The menu has closed by the time an item runs, and focus went with it, so the item hands focus back to the row.
    // Only Escape and the items do: a click elsewhere that closes the menu keeps the focus it gave.
    private void FromMenu(Action action)
    {
        action();
        ReturnFocusToContextRow();
    }

    private async Task FromMenuAsync(Func<Task> action)
    {
        await action();
        ReturnFocusToContextRow();
    }

    // Back to the cell that was right-clicked when it can take focus, as edit mode's cells can, or else the row's checkbox.
    private void ReturnFocusToContextRow()
    {
        if (_contextRow is not { } row)
        {
            return;
        }

        if (IsEditing && _contextColumn is { } column && _editSession == null)
        {
            FocusCell(row.Index, column);
        }
        else
        {
            _focusRowCheckbox = row.Index;
        }
    }

    // The selected rows the grid shows, in its order, so what the menu copies, exports or deletes is what's in view.
    private List<ResultRow> SelectedShownRows() =>
        _view.Rows.Where(r => SelectionState.IsSelected(r.Index)).ToList();

    private Task CopyCellAsync(ResultRow row, string column) => FromMenuAsync(() =>
        Bus.PublishAsync(new CopyCellToClipboard(ResultValueFormatter.Full(row.Values.GetValueOrDefault(column)) ?? "")));

    private Task CopyRowAsync(ResultRow row, string format) => FromMenuAsync(() =>
        Bus.PublishAsync(new CopyRowToClipboard(row.Values, Result.Columns, format, Result.Headers())));

    private Task CopyRowsAsync(IReadOnlyList<ResultRow> rows) => FromMenuAsync(() =>
        Bus.PublishAsync(new CopySelectedRowsToClipboard(rows.Select(r => r.Values).ToList(), Result.Columns, "Csv", Result.Headers())));

    private Task ExportRowsAsync(IReadOnlyList<ResultRow> rows, string format) => FromMenuAsync(() =>
        Bus.PublishAsync(new ExportSelectedRows(rows.Select(r => r.Values).ToList(), Result.Columns, format, Result.Headers())));

    private Task ViewRowAsJsonAsync(ResultRow row) => FromMenuAsync(async () =>
    {
        string json;
        try
        {
            json = JsonSerializer.Serialize(row.Values);
        }
        catch (NotSupportedException)
        {
            await Bus.PublishAsync(new AddNotification("This row has values that can't be shown as JSON", Severity.Warning));
            return;
        }

        await OpenJsonDetailView($"Row {_view.PositionOf(row.Index) + 1}", json);
    });

    private sealed record RelatedRow(string Column, ForeignKeyInfo ForeignKey, object Value, string Label);

    // The rows this row's foreign keys point at. Only rows from one known table know which columns those are.
    private List<RelatedRow> RelatedRows(ResultRow row)
    {
        if (!ConnectionId.HasValue || string.IsNullOrEmpty(DatabaseName))
        {
            return [];
        }

        // A key being edited links to the row its new value names, as the cell's own link does.
        var links = _columns
            .Select(column => IsForeignKeyColumn(column.Key, out var foreignKey)
                && (Edits is { } edits ? edits.GetEffectiveValue(row.Index, column.Key, row.Values) : row.Values.GetValueOrDefault(column.Key)) is { } value
                    ? new RelatedRow(column.Key, foreignKey!, value, $"Show {foreignKey!.ReferencedTable} row")
                    : null)
            .OfType<RelatedRow>()
            .ToList();

        // Two keys into the same table, such as created_by and updated_by, are told apart by their columns.
        return links
            .Select(link => links.Count(l => l.ForeignKey.ReferencedTable == link.ForeignKey.ReferencedTable) > 1
                ? link with { Label = $"{link.Label} ({link.Column})" }
                : link)
            .ToList();
    }

    private Task OpenForeignKeyFromMenuAsync(RelatedRow link, ResultRow row) =>
        FromMenuAsync(() => OpenForeignKeyView(link.Column, link.ForeignKey, link.Value, row));

    protected async Task OpenJsonDetailView(string column, string json)
    {
        await Bus.PublishAsync(new OpenJsonDetailView(new QueryResponseJsonDetail(QueryName, column, json)));
    }

    private bool IsForeignKeyColumn(string column, out ForeignKeyInfo? fkInfo)
    {
        fkInfo = EditMetadata?.ColumnMetadata
            .FirstOrDefault(c => c.Name == column && c.IsForeignKey)?.ForeignKey;
        return fkInfo != null;
    }

    protected async Task OpenForeignKeyView(string column, ForeignKeyInfo fkInfo, object value, ResultRow row)
    {
        if (!ConnectionId.HasValue || string.IsNullOrEmpty(DatabaseName)) return;

        var detail = ForeignKeyDetailFor(column, fkInfo, value);

        var choices = (EditMetadata?.ColumnMetadata ?? [])
            .Where(c => c.ForeignKey != null && Result.Columns.Contains(c.Name))
            .Select(c => (Column: c, Value: Edits?.GetEffectiveValue(row.Index, c.Name, row.Values) ?? row.Values.GetValueOrDefault(c.Name)))
            .Where(choice => choice.Value != null)
            .Select(choice => choice.Column.Name == column ? detail : ForeignKeyDetailFor(choice.Column.Name, choice.Column.ForeignKey!, choice.Value!))
            .ToList();

        await Bus.PublishAsync(new OpenForeignKeyView(detail, choices));
    }

    private ForeignKeyDetail ForeignKeyDetailFor(string column, ForeignKeyInfo foreignKey, object value) => new(
        QueryName,
        column,
        foreignKey.ReferencedTable,
        foreignKey.ReferencedColumn,
        value,
        ConnectionId!.Value,
        DatabaseName!,
        foreignKey.ReferencedSchema);
}
