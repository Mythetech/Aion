    protected async Task OpenJsonDetailView(string column, string json)
    {
        await Bus.PublishAsync(new OpenJsonDetailView(new QueryResponseJsonDetail(QueryName, column, json)));
    }

    private bool IsForeignKeyColumn(string column, out ForeignKeyInfo? fkInfo)
    {
        fkInfo = EditMetadata?.ColumnMetadata
            .FirstOrDefault(c => c.Name == column && c.IsForeignKey)?.ForeignKey;
        return fkInfo != null;
    }

    protected async Task OpenForeignKeyView(string column, ForeignKeyInfo fkInfo, object value, ResultRow row)
    {
        if (!ConnectionId.HasValue || string.IsNullOrEmpty(DatabaseName)) return;

        var detail = ForeignKeyDetailFor(column, fkInfo, value);

        var choices = (EditMetadata?.ColumnMetadata ?? [])
            .Where(c => c.ForeignKey != null && Result.Columns.Contains(c.Name))
            .Select(c => (Column: c, Value: Edits?.GetEffectiveValue(row.Index, c.Name, row.Values) ?? row.Values.GetValueOrDefault(c.Name)))
            .Where(choice => choice.Value != null)
            .Select(choice => choice.Column.Name == column ? detail : ForeignKeyDetailFor(choice.Column.Name, choice.Column.ForeignKey!, choice.Value!))
            .ToList();

        await Bus.PublishAsync(new OpenForeignKeyView(detail, choices));
    }

    private ForeignKeyDetail ForeignKeyDetailFor(string column, ForeignKeyInfo foreignKey, object value) => new(
        QueryName,
        column,
        foreignKey.ReferencedTable,
        foreignKey.ReferencedColumn,
        value,
        ConnectionId!.Value,
        DatabaseName!,
        foreignKey.ReferencedSchema);
}
