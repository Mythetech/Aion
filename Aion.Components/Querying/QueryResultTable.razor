@using Aion.Components.History
@using Aion.Components.Querying.Commands
@using Aion.Components.Querying.Consumers
@using Aion.Components.Querying.Editing
@using Aion.Components.Querying.Results
@using Aion.Components.RequestContextPanel
@using Aion.Components.RequestContextPanel.Commands
@using Aion.Components.Settings.Domains
@using Aion.Components.Shared
@using Aion.Components.Theme
@using Aion.Contracts.Database
@using Aion.Contracts.Queries
@using Mythetech.Framework.Infrastructure.MessageBus
@inherits ComponentBaseWithState
@implements IDisposable

<div class="result-grid">
<MudDataGrid T="ResultRow"
             Items="@_shownRows"
             Dense="true"
             Hover="true"
             Filterable="true"
             Virtualize="true"
             ItemSize="@RowHeight"
             OverscanCount="20"
             ColumnResizeMode="ResizeMode.Container"
             Class="query-result-table">
    <Columns>
        @* Selection column *@
        <TemplateColumn T="ResultRow"
                        Title=""
                        Sortable="false"
                        Filterable="false"
                        Resizable="false"
                        CellStyle="width: 40px; min-width: 40px; max-width: 40px;">
            <HeaderTemplate>
                <MudCheckBox T="bool"
                             Value="@SelectionState.SelectAllChecked"
                             ValueChanged="@ToggleSelectAll"
                             Size="Size.Small"
                             Dense="true" />
            </HeaderTemplate>
            <CellTemplate>
                @{
                    var rowIndex = context.Item.Index;
                }
                <MudCheckBox T="bool"
                             Value="@SelectionState.IsSelected(rowIndex)"
                             ValueChanged="@(v => HandleRowSelect(rowIndex, v))"
                             Size="Size.Small"
                             Dense="true" />
            </CellTemplate>
        </TemplateColumn>

        @* Data columns *@
        @foreach (var col in Result.Columns)
        {
            <TemplateColumn T="ResultRow" Title="@col" Resizable="true">
                <CellTemplate>
                    @{
                        var row = context.Item.Values;
                        var value = row.GetValueOrDefault(col);
                        var rowIndex = context.Item.Index;
                        var effectiveValue = EditState?.GetEffectiveValue(rowIndex, col, row) ?? value;
                        var cellClass = GetCellClass(rowIndex, col);
                        var rowClass = GetRowClass(rowIndex);
                    }
                    <div class="cell-content @cellClass @rowClass"
                         @oncontextmenu="@(e => ShowContextMenu(e, context.Item, col, value))"
                         @oncontextmenu:preventDefault="true"
                         @onclick="@(e => HandleCellClick(rowIndex, e))">
                        @if (EditMetadata?.IsEditMode == true && !IsRowDeleted(rowIndex))
                        {
                            @* Foreign key metadata only exists in edit mode, so the editable cell is where the reference opens from. *@
                            var editForeignKey = effectiveValue != null && IsForeignKeyColumn(col, out var fk) ? fk : null;
                            <MudTextField T="string"
                                          Value="@(effectiveValue?.ToString() ?? "")"
                                          ValueChanged="@(newValue => OnCellValueChanged(rowIndex, col, newValue, row))"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Dense="true"
                                          Immediate="false"
                                          DisableUnderLine="true"
                                          Disabled="@IsPrimaryKeyColumn(col)"
                                          Adornment="@(editForeignKey is null ? Adornment.None : Adornment.End)"
                                          AdornmentIcon="@(editForeignKey is null ? null : AionIcons.ForeignKey)"
                                          AdornmentAriaLabel="@(editForeignKey is null ? null : $"Show {col} reference")"
                                          OnAdornmentClick="@(() => editForeignKey is null ? Task.CompletedTask : OpenForeignKeyView(col, editForeignKey, effectiveValue!, context.Item))"
                                          Class="cell-editing" />
                        }
                        else if (effectiveValue != null && effectiveValue.ToString()!.StartsWith('{') && effectiveValue.ToString()!.EndsWith('}'))
                        {
                            <MudLink Class="overflow-x-auto d-flex"
                                     OnClick="@(async () => await OpenJsonDetailView(col, effectiveValue.ToString()!))">
                                @effectiveValue
                            </MudLink>
                        }
                        else if (IsForeignKeyColumn(col, out var fkInfo) && effectiveValue != null)
                        {
                            <MudLink Class="overflow-x-auto d-flex"
                                     OnClick="@(async () => await OpenForeignKeyView(col, fkInfo!, effectiveValue, context.Item))">
                                @effectiveValue
                                <MudIcon Icon="@AionIcons.ForeignKey" Size="Size.Small" Class="ml-1" />
                            </MudLink>
                        }
                        else
                        {
                            <MudText Class="overflow-x-auto d-flex">@effectiveValue</MudText>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
</MudDataGrid>
</div>
@if (_shownRows.Count < _view.Count)
{
    <div class="result-limit-bar">
        <span>Showing @_shownRows.Count.ToString("N0") of @_view.Count.ToString("N0") @(_view.IsFiltered ? "matching rows" : "rows")</span>
        <MudButton Class="result-load-more" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="LoadMore">
            Load @Math.Min(RowLimit, _view.Count - _shownRows.Count).ToString("N0") more
        </MudButton>
        <MudButton Class="result-show-all" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="ShowAll">
            Show all
        </MudButton>
    </div>
}

@* Context Menu *@
<AionMenu @ref="_contextMenu"
         AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft"
         PositionAtCursor="true">
    <ChildContent>
        <MudMenuItem OnClick="@CopyCellValue" Icon="@AionIcons.Copy">
            Copy Cell
        </MudMenuItem>
        <MudMenuItem OnClick="@CopyRowAsJson" Icon="@AionIcons.Json">
            Copy Row as JSON
        </MudMenuItem>
        <MudMenuItem OnClick="@CopyRowAsCsv" Icon="@AionIcons.Csv">
            Copy Row as CSV
        </MudMenuItem>

        @if (SelectionState.HasSelection)
        {
            <MudDivider />
            <MudMenuItem OnClick="@CopySelectedRows" Icon="@AionIcons.Copy">
                Copy Selected (@QueryHistoryFormatter.Rows(SelectionState.SelectedCount))
            </MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="@ExportSelectedCsv" Icon="@AionIcons.Csv">
                Export Selected to CSV
            </MudMenuItem>
            <MudMenuItem OnClick="@ExportSelectedJson" Icon="@AionIcons.Json">
                Export Selected to JSON
            </MudMenuItem>
            <MudMenuItem OnClick="@ExportSelectedExcel" Icon="@AionIcons.Spreadsheet">
                Export Selected to Excel
            </MudMenuItem>
        }

        @if (EditMetadata?.IsEditMode == true && _contextRow != null)
        {
            <MudDivider />
            @if (IsRowDeleted(_contextRow.Index))
            {
                <MudMenuItem OnClick="@UndeleteContextRow" Icon="@AionIcons.Undo" IconColor="Color.Success">
                    Restore Row
                </MudMenuItem>
            }
            else
            {
                <MudMenuItem OnClick="@DeleteContextRow" Icon="@AionIcons.Delete" IconColor="Color.Error">
                    Delete Row
                </MudMenuItem>
            }
        }
    </ChildContent>
</AionMenu>

@code {
    [Parameter] public required QueryResult Result { get; set; }
    [Parameter] public required string QueryName { get; set; }
    [Parameter] public string? SearchFilter { get; set; }
    [Parameter] public RowSelectionState SelectionState { get; set; } = new();
    [Parameter] public EditState? EditState { get; set; }
    [Parameter] public QueryEditMetadata? EditMetadata { get; set; }
    [Parameter] public Guid? ConnectionId { get; set; }
    [Parameter] public string? DatabaseName { get; set; }

    [Inject] protected IMessageBus Bus { get; set; } = default!;
    [Inject] protected ResultsSettings ResultsSettings { get; set; } = default!;

    private const int RowHeight = 37;

    private AionMenu? _contextMenu;

    // Context menu state
    private ResultRow? _contextRow;
    private string? _contextColumn;
    private object? _contextValue;

    private EditState? _subscribedEditState;

    private QueryResult? _viewResult;
    private IReadOnlyList<ResultRow> _rows = [];
    private ResultGridView _view = ResultGridView.Empty;
    private IReadOnlyList<ResultRow> _shownRows = [];
    private int _shownLimit;

    public QueryResultTable()
    {
        // One handler for both, so a new result that arrives with a new filter builds the view once.
        using var registerScope = CreateRegisterScope();
        registerScope.RegisterParameter<QueryResult>(nameof(Result))
            .WithParameter(() => Result)
            .WithChangeHandler(OnViewInputsChanged);
        registerScope.RegisterParameter<string?>(nameof(SearchFilter))
            .WithParameter(() => SearchFilter)
            .WithChangeHandler(OnViewInputsChanged);
    }

    private int RowLimit => ResultsSettings.EffectiveRowLimit;

    private void OnViewInputsChanged()
    {
        if (!ReferenceEquals(_viewResult, Result))
        {
            _viewResult = Result;
            _rows = ResultRow.Wrap(Result.Rows);
            _shownLimit = RowLimit;
        }

        _view = ResultGridView.Build(_rows, SearchFilter);
        _shownRows = _view.Take(_shownLimit);
        StateHasChanged();
    }

    private void LoadMore()
    {
        _shownLimit += RowLimit;
        _shownRows = _view.Take(_shownLimit);
    }

    private void ShowAll()
    {
        _shownLimit = int.MaxValue;
        _shownRows = _view.Rows;
    }

    protected override void OnParametersSet()
    {
        // Each edit session has its own EditState, so follow the parameter instead of the first instance seen.
        if (!ReferenceEquals(_subscribedEditState, EditState))
        {
            if (_subscribedEditState != null)
            {
                _subscribedEditState.StateChanged -= OnEditStateChanged;
            }

            if (EditState != null)
            {
                EditState.StateChanged += OnEditStateChanged;
            }

            _subscribedEditState = EditState;
        }

        base.OnParametersSet();
    }

    private void OnEditStateChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_subscribedEditState != null)
        {
            _subscribedEditState.StateChanged -= OnEditStateChanged;
        }
    }

    // Edit mode helper methods
    private bool IsPrimaryKeyColumn(string column) =>
        EditMetadata?.ColumnMetadata.Any(c => c.Name == column && c.IsPrimaryKey) == true;

    private bool IsRowDeleted(int rowIndex) =>
        EditState?.IsRowDeleted(rowIndex) == true;

    private string GetRowClass(int rowIndex)
    {
        if (EditState?.IsRowDeleted(rowIndex) == true) return "row-deleted";
        if (EditState?.IsRowInserted(rowIndex) == true) return "row-inserted";
        return "";
    }

    private string GetCellClass(int rowIndex, string column)
    {
        if (EditState?.IsCellModified(rowIndex, column) == true) return "cell-modified";
        return "";
    }

    private void OnCellValueChanged(int rowIndex, string column, string? newValue, Dictionary<string, object> originalRow)
    {
        if (EditState == null) return;

        // Convert empty string to null for nullable columns
        object? valueToSet = string.IsNullOrEmpty(newValue) ? null : newValue;
        EditState.UpdateCell(rowIndex, column, valueToSet, originalRow);
    }

    private void DeleteContextRow()
    {
        if (_contextRow == null || EditState == null) return;
        EditState.DeleteRow(_contextRow.Index, _contextRow.Values);
    }

    private void UndeleteContextRow()
    {
        if (_contextRow == null || EditState == null) return;
        EditState.UndeleteRow(_contextRow.Index);
    }

    private void HandleCellClick(int rowIndex, MouseEventArgs e)
    {
        SelectionState.ToggleSelection(rowIndex, e.CtrlKey, e.ShiftKey, Result.Rows.Count);
        StateHasChanged();
    }

    private void HandleRowSelect(int rowIndex, bool selected)
    {
        if (selected)
        {
            SelectionState.ToggleSelection(rowIndex, ctrlKey: true, shiftKey: false, Result.Rows.Count);
        }
        else
        {
            SelectionState.SelectedIndices.Remove(rowIndex);
        }
        StateHasChanged();
    }

    private void ToggleSelectAll(bool selectAll)
    {
        if (selectAll)
        {
            SelectionState.SelectAll(Result.Rows.Count);
        }
        else
        {
            SelectionState.ClearSelection();
        }
        StateHasChanged();
    }

    private async Task ShowContextMenu(MouseEventArgs e, ResultRow row, string column, object? value)
    {
        _contextRow = row;
        _contextColumn = column;
        _contextValue = value;

        // Select the row if not already selected
        var rowIndex = row.Index;
        if (!SelectionState.IsSelected(rowIndex))
        {
            SelectionState.ToggleSelection(rowIndex, ctrlKey: false, shiftKey: false, Result.Rows.Count);
        }

        if (_contextMenu != null)
        {
            await _contextMenu.OpenMenuAsync(e);
        }
        StateHasChanged();
    }

    private async Task CopyCellValue()
    {
        if (_contextValue == null) return;
        await Bus.PublishAsync(new CopyCellToClipboard(_contextValue.ToString() ?? ""));
    }

    private async Task CopyRowAsJson()
    {
        if (_contextRow == null) return;
        await Bus.PublishAsync(new CopyRowToClipboard(_contextRow.Values, Result.Columns, "Json"));
    }

    private async Task CopyRowAsCsv()
    {
        if (_contextRow == null) return;
        await Bus.PublishAsync(new CopyRowToClipboard(_contextRow.Values, Result.Columns, "Csv"));
    }

    private async Task CopySelectedRows()
    {
        var selectedRows = SelectionState.GetSelectedRows(Result.Rows);
        await Bus.PublishAsync(new CopySelectedRowsToClipboard(selectedRows, Result.Columns, "Csv"));
    }

    private async Task ExportSelectedCsv()
    {
        var selectedRows = SelectionState.GetSelectedRows(Result.Rows);
        await Bus.PublishAsync(new ExportSelectedRows(selectedRows, Result.Columns, "Csv"));
    }

    private async Task ExportSelectedJson()
    {
        var selectedRows = SelectionState.GetSelectedRows(Result.Rows);
        await Bus.PublishAsync(new ExportSelectedRows(selectedRows, Result.Columns, "Json"));
    }

    private async Task ExportSelectedExcel()
    {
        var selectedRows = SelectionState.GetSelectedRows(Result.Rows);
        await Bus.PublishAsync(new ExportSelectedRows(selectedRows, Result.Columns, "Excel"));
    }

    protected async Task OpenJsonDetailView(string column, string json)
    {
        await Bus.PublishAsync(new OpenJsonDetailView(new QueryResponseJsonDetail(QueryName, column, json)));
    }

    private bool IsForeignKeyColumn(string column, out ForeignKeyInfo? fkInfo)
    {
        fkInfo = EditMetadata?.ColumnMetadata
            .FirstOrDefault(c => c.Name == column && c.IsForeignKey)?.ForeignKey;
        return fkInfo != null;
    }

    protected async Task OpenForeignKeyView(string column, ForeignKeyInfo fkInfo, object value, ResultRow row)
    {
        if (!ConnectionId.HasValue || string.IsNullOrEmpty(DatabaseName)) return;

        var detail = ForeignKeyDetailFor(column, fkInfo, value);

        var choices = (EditMetadata?.ColumnMetadata ?? [])
            .Where(c => c.ForeignKey != null && Result.Columns.Contains(c.Name))
            .Select(c => (Column: c, Value: EditState?.GetEffectiveValue(row.Index, c.Name, row.Values) ?? row.Values.GetValueOrDefault(c.Name)))
            .Where(choice => choice.Value != null)
            .Select(choice => choice.Column.Name == column ? detail : ForeignKeyDetailFor(choice.Column.Name, choice.Column.ForeignKey!, choice.Value!))
            .ToList();

        await Bus.PublishAsync(new OpenForeignKeyView(detail, choices));
    }

    private ForeignKeyDetail ForeignKeyDetailFor(string column, ForeignKeyInfo foreignKey, object value) => new(
        QueryName,
        column,
        foreignKey.ReferencedTable,
        foreignKey.ReferencedColumn,
        value,
        ConnectionId!.Value,
        DatabaseName!,
        foreignKey.ReferencedSchema);
}
