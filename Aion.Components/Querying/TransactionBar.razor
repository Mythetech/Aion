@using Aion.Components.Connections.Commands
@using Aion.Components.Theme
@using Aion.Contracts.Queries
@using Mythetech.Framework.Infrastructure.MessageBus

@if (Query.Transaction is { Status: TransactionStatus.Active } transaction)
{
    <div class="transaction-bar" role="status">
        <MudIcon Icon="@AionIcons.Transaction" Size="Size.Small" Color="Color.Warning" />
        <MudText Typo="Typo.body2" Class="transaction-bar-title">Transaction open</MudText>
        <MudText Typo="Typo.caption" Class="transaction-bar-summary mud-text-secondary">@Summarize(transaction)</MudText>
        <MudSpacer />
        <MudButton Class="transaction-bar-rollback"
                   Size="Size.Small"
                   Variant="Variant.Text"
                   Color="Color.Error"
                   StartIcon="@AionIcons.RollbackTransaction"
                   Disabled="@IsBusy"
                   OnClick="RollbackAsync">
            Rollback
        </MudButton>
        <MudButton Class="transaction-bar-commit"
                   Size="Size.Small"
                   Variant="Variant.Filled"
                   Color="Color.Success"
                   DropShadow="false"
                   StartIcon="@AionIcons.CommitTransaction"
                   Disabled="@IsBusy"
                   OnClick="CommitAsync">
            Commit
        </MudButton>
    </div>
}

@code {
    [Inject] protected IMessageBus Bus { get; set; } = default!;

    [Parameter, EditorRequired]
    public QueryModel Query { get; set; } = default!;

    private bool _finishing;

    // Ending the transaction while a statement is still running on its connection would fail, so wait.
    private bool IsBusy => _finishing || Query.IsExecuting;

    private static string Summarize(TransactionInfo transaction) =>
        $"{Count(transaction.StatementCount, "statement")} · {Count(transaction.RowsChanged, "row")} changed · started {transaction.StartTime.ToLocalTime():t}";

    private static string Count(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count:N0} {noun}s";

    private async Task CommitAsync()
    {
        _finishing = true;
        try
        {
            await Bus.PublishAsync(new CommitTransaction(Query));
        }
        finally
        {
            _finishing = false;
        }
    }

    private async Task RollbackAsync()
    {
        _finishing = true;
        try
        {
            await Bus.PublishAsync(new RollbackTransaction(Query));
        }
        finally
        {
            _finishing = false;
        }
    }
}
