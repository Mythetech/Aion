@using System.Text.Json.Nodes
@using Mythetech.Framework.Infrastructure.MessageBus
@using Aion.Components.Connections
@using Aion.Components.Querying.Commands
@using Aion.Components.Querying.Consumers
@using Aion.Components.Querying.Editing
@using Aion.Components.RequestContextPanel
@using Aion.Components.RequestContextPanel.Commands
@using Aion.Components.Shared
@using Aion.Components.Theme
@using Aion.Contracts.Database
@using Aion.Contracts.Queries
@using Aion.Contracts.Queries.Editing
@using Aion.Components.Shared.Loaders
@using Aion.Components.Querying
@using Aion.Components.Querying.Results
@using Aion.Components.Visualization
@using Aion.Components.Querying.Errors
@using Aion.Components.Querying.Messages
@implements IDisposable

@if (State?.Active?.Result != null && (!State?.Active?.IsExecuting ?? false))
{
    QueryResult queryResult = State.Active.Result;
    <MudStack Class="pa-4 h-100 w-100">
        @* Tabs and export actions keep their size; the find box shrinks to its minimum before anything overlaps. *@
        <div class="results-header">
            <div class="results-tabs">
                <MudTabs @ref="_tabs" Class="py-2 px-1" MinimumTabWidth="96px">
                    <MudTabPanel ID="@Results" Text="Results" OnClick="() => _activeTab = Results" />
                    <MudTabPanel ID="@Messages" Text="Messages" OnClick="() => _activeTab = Messages" />
                    @if (State.Active.EstimatedPlan != null)
                    {
                        <MudTabPanel ID="@EstimatedPlan" Text="Estimated Plan" OnClick="() => _activeTab = EstimatedPlan" />
                    }
                    @if (State.Active.ActualPlan != null)
                    {
                        <MudTabPanel ID="@ActualPlan" Text="Actual Plan" OnClick="() => _activeTab = ActualPlan" />
                    }
                    @if (State.Active.EditMetadata?.IsEditMode == true)
                    {
                        <MudTabPanel ID="@Edit" Text="Edit" Icon="@AionIcons.Edit" OnClick="() => _activeTab = Edit" />
                    }
                    @if (queryResult.Success && queryResult.Rows.Count > 0)
                    {
                        <MudTabPanel ID="@Analyze" Text="Analyze" OnClick="() => _activeTab = Analyze" />
                    }
                </MudTabs>
            </div>
            <div class="results-find">
                <MudTextField
                    T="string"
                    @bind-Value="@_search"
                    Class="rounded-xl"
                    Variant="Variant.Text"
                    Margin="Margin.Dense"
                    Clearable="true"
                    Immediate="true"
                    DebounceInterval="200"
                    AdornmentIcon="@AionIcons.Filter"
                    Adornment="Adornment.End"
                    Placeholder="Find in results..." />
            </div>
            <div class="results-actions">
                @if (_selectionState.HasSelection)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @_selectionState.SelectedCount selected
                    </MudChip>
                }
                <AionIconButton Icon="@AionIcons.Json" Tooltip="Export to JSON" OnClick="async () => await Bus.PublishAsync(new ExportResultsToJson(RowsToExport(queryResult), queryResult.Rows.Count))" />
                <AionIconButton Icon="@AionIcons.Csv" Tooltip="Export to CSV" OnClick="async () => await Bus.PublishAsync(new ExportResultsToCsv(RowsToExport(queryResult), queryResult.Rows.Count))" />
                <AionIconButton Icon="@AionIcons.Spreadsheet" Tooltip="Export to Excel" OnClick="async () => await Bus.PublishAsync(new ExportResultsToExcel(RowsToExport(queryResult), queryResult.Rows.Count))" />
            </div>
        </div>
        @if (_activeTab == Results)
        {
            <MudStack Class="h-100 w-100 overflow-auto flex-shrink-1">
                @if (queryResult.Cancelled)
                {
                    <MudText Typo="Typo.body2" Class="query-cancelled mud-text-secondary ma-2">The query was cancelled before it finished.</MudText>
                }
                else if (!queryResult.Success)
                {
                    <QueryErrorCard Query="@State.Active" />
                }
                else
                {
                    <QueryResultTable Result="@State.Active.Result"
                                      QueryName="@State.Active.Name"
                                      SearchFilter="@_search"
                                      SelectionState="@_selectionState"
                                      EditState="@GetEditState()"
                                      EditMetadata="@State.Active.EditMetadata"
                                      ConnectionId="@State.Active.ConnectionId"
                                      DatabaseName="@State.Active.DatabaseName"
                                      DatabaseType="@GetActiveDatabaseType()" />
                }
            </MudStack>
        }
        else if (_activeTab == Messages)
        {
            var messages = MessageLog.For(State.Active.Id);
            @* The reversed flex column keeps the scroll pinned to the newest line without scripting the scroll position. *@
            <div class="query-messages" role="log" aria-label="Messages">
                <div class="query-messages-lines">
                    @if (messages.Count > 0)
                    {
                        @foreach (var message in messages)
                        {
                            <div class="query-message">
                                <span class="query-message-time">@message.Time.ToLocalTime().ToString("T")</span>
                                <span class="query-message-text @MessageClass(message.Kind)" title="@message.Detail">@message.Text</span>
                                @if (message.Duration is { } duration)
                                {
                                    <span class="query-message-duration">(@QueryTimer.FormatDuration(duration))</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @* The log lives only as long as the session, while a tab's last result is saved with it. *@
                        <div class="query-message">
                            <span class="query-message-time">@queryResult.ExecutedAt.ToString("T")</span>
                            @if (queryResult.Cancelled)
                            {
                                <span class="query-message-text">Query cancelled</span>
                            }
                            else if (!queryResult.Success)
                            {
                                <span class="query-message-text query-message-error">@QueryErrorText.LogLine(queryResult.ErrorDetail ?? QueryErrorNormalizer.Normalize(queryResult.Error!))</span>
                            }
                            else
                            {
                                <span class="query-message-text">@DescribeResult(queryResult)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (_activeTab == EstimatedPlan)
        {
            <QueryPlanVisualizer Plan="@State.Active.EstimatedPlan" DatabaseType="@GetActiveDatabaseType()" />
        }
        else if (_activeTab == ActualPlan)
        {
            <QueryPlanVisualizer Plan="@State.Active.ActualPlan" DatabaseType="@GetActiveDatabaseType()" />
        }
        else if (_activeTab == Edit && State.Active.EditMetadata?.IsEditMode == true)
        {
            var editState = GetEditState();
            @if (editState != null)
            {
                <PendingChangesPanel
                    EditState="@editState"
                    EditableResult="@GetEditableResult()"
                    OnApplyChanges="@ApplyChanges"
                    OnDiscardChanges="@DiscardChanges"
                    OnExitEditMode="@ExitEditMode" />
            }
        }
        else if (_activeTab == Analyze && queryResult.Success && queryResult.Rows.Count > 0)
        {
            <AnalyzePanel Result="@queryResult" />
        }
        <div class="query-response-footer d-flex flex-row align-center">
            @if (queryResult.Cancelled)
            {
                <span class="query-status-cancelled">Cancelled</span>
                <span class="query-status-duration">@FormatDuration(State.Active)</span>
            }
            else if (!queryResult.Success)
            {
                <span class="query-status-failed">Failed</span>
                <span class="query-status-duration">@FormatDuration(State.Active)</span>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(State.Active.ResultKind.PlanSummary() ?? DescribeResult(queryResult))
                </MudText>
                <MudDivider Vertical="true" />
                <QueryTimer StartTime="@State.Active.ExecutionStartTime" EndTime="@State.Active.ExecutionEndTime" Typo="Typo.caption" />
            }
        </div>
    </MudStack>
}
else if (State?.Active?.IsExecuting ?? false)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Class="h-100" Style="position:relative;overflow:hidden;">
        <MudSkeleton Width="100%" Height="97%" SkeletonType="SkeletonType.Rectangle" Style="position:absolute;" Class="ml-8" Animation="Animation.Wave"/>
        <WaveLoader />
        <LoadingText Text="Running Query" />
        <QueryTimer StartTime="@State.Active.ExecutionStartTime" EndTime="@State.Active.ExecutionEndTime" />
    </MudStack>
}



@code {
    [Inject] protected QueryState State { get; set; } = default!;
    [Inject] protected IMessageBus Bus { get; set; } = default!;
    [Inject] protected ConnectionState Connections { get; set; } = default!;
    [Inject] protected QueryMessageLog MessageLog { get; set; } = default!;

    private string? _search = "";
    private const string Results = "results";
    private const string Edit = "edit";
    private const string Analyze = "analyze";
    private const string Messages = "messages";
    private const string EstimatedPlan = "estimated";
    private const string ActualPlan = "actual";

    private string _activeTab = Results;
    private MudTabs? _tabs;
    private RowSelectionState _selectionState = new();

    // The tab and result the selected rows belong to.
    private Guid? _selectionQueryId;
    private QueryResult? _selectionResult;

    [Parameter] public QueryPlan? QueryPlan { get; set; }

    protected override void OnInitialized()
    {
        State.StateChanged += OnStateChanged;
        MessageLog.MessagesChanged += OnMessagesChanged;
        _selectionState.SelectionChanged += StateHasChanged;
        _selectionQueryId = State.Active?.Id;
        _selectionResult = State.Active?.Result;
        _activeTab = TabFor(State.Active);
        base.OnInitialized();
    }

    // The tabs strip is rebuilt after every run and its panels come and go with the result, so after each
    // render it is pointed at the tab the content shows instead of keeping a choice of its own.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tabs != null && !Equals(_tabs.ActivePanel?.ID, _activeTab))
        {
            await _tabs.ActivatePanelAsync(_activeTab);
        }
    }

    /// <summary>
    /// The tab a result opens on: a plan run shows its plan, and anything else its results, unless the
    /// Messages log or the edit panel is open, which keep following the tab.
    /// </summary>
    private string TabFor(QueryModel? query) => query switch
    {
        { ResultKind: QueryResultKind.EstimatedPlan, EstimatedPlan: not null } => EstimatedPlan,
        { ResultKind: QueryResultKind.ActualPlan, ActualPlan: not null } => ActualPlan,
        _ when _activeTab is Messages or Edit => _activeTab,
        _ => Results
    };

    private void OnStateChanged()
    {
        // Row indexes only mean something for the result they were picked in, so a different tab or a new
        // result clears the selection and picks the tab to show; other changes, such as a tab being saved,
        // keep both.
        if (State.Active?.Id != _selectionQueryId || !ReferenceEquals(State.Active?.Result, _selectionResult))
        {
            _selectionState.ClearSelection();
            _selectionQueryId = State.Active?.Id;
            _selectionResult = State.Active?.Result;
            _activeTab = TabFor(State.Active);
        }

        if (_activeTab == Edit && State.Active?.EditMetadata?.IsEditMode != true)
        {
            _activeTab = Results;
        }

        StateHasChanged();
    }

    private void OnMessagesChanged(Guid queryId)
    {
        if (_activeTab == Messages && queryId == State.Active?.Id)
        {
            StateHasChanged();
        }
    }

    private static string MessageClass(QueryMessageKind kind) => kind switch
    {
        QueryMessageKind.Transaction => "query-message-transaction",
        QueryMessageKind.Statement => "query-message-statement",
        QueryMessageKind.Success => "query-message-success",
        QueryMessageKind.Error => "query-message-error",
        _ => "query-message-info"
    };

    // Exports follow find in results, so they hold the rows the grid shows rather than every row fetched.
    private QueryResult RowsToExport(QueryResult result) => ResultRowFilter.Apply(result, _search);

    private static string FormatDuration(QueryModel query) =>
        query.ExecutionDuration is { } duration ? QueryTimer.FormatDuration(duration) : string.Empty;

    private static string DescribeResult(QueryResult result) =>
        result.Columns.Count == 0 && result.RowsAffected is { } affected
            ? $"{affected} row{(affected == 1 ? "" : "s")} affected"
            : $"{result.RowCount} Results";

    private DatabaseType GetActiveDatabaseType()
    {
        var connectionId = State.Active?.ConnectionId;
        if (connectionId == null) return default;
        var connection = Connections.Connections.FirstOrDefault(c => c.Id == connectionId);
        return connection?.Type ?? default;
    }

    private EditState? GetEditState()
    {
        var metadata = State.Active?.EditMetadata;
        return metadata?.IsEditMode == true ? metadata.EditState : null;
    }

    private EditableQueryResult? GetEditableResult()
    {
        if (State.Active?.Result == null || State.Active.EditMetadata == null) return null;
        return EditableQueryResult.FromQueryResult(
            State.Active.Result,
            State.Active.EditMetadata.SourceTable,
            State.Active.EditMetadata.SourceSchema,
            State.Active.EditMetadata.SourceDatabase,
            State.Active.EditMetadata.ConnectionId,
            State.Active.EditMetadata.ColumnMetadata);
    }

    private async Task ApplyChanges()
    {
        var editState = GetEditState();
        var editableResult = GetEditableResult();
        if (editState != null && editableResult != null)
        {
            await Bus.PublishAsync(new ApplyPendingChanges(editState, editableResult));

            // If changes were cleared (success), exit edit mode
            // The consumer clears changes on success
            if (!editState.HasChanges)
            {
                ExitEditMode();
            }
        }
    }

    private void DiscardChanges()
    {
        GetEditState()?.DiscardAllChanges();
    }

    private void ExitEditMode()
    {
        if (State.Active == null) return;

        // Pending changes live on the metadata, so clearing it also drops them
        State.Active.EditMetadata = null;

        // Switch back to Results tab
        _activeTab = Results;

        StateHasChanged();
    }

    public void Dispose()
    {
        State.StateChanged -= OnStateChanged;
        MessageLog.MessagesChanged -= OnMessagesChanged;
        _selectionState.SelectionChanged -= StateHasChanged;
    }
}