@inherits MudComponentBase
@using Color = MudBlazor.Color;

@if (!string.IsNullOrWhiteSpace(Tooltip))
{
    <MudTooltip Text="@Tooltip" Color="@Color" Placement="@TooltipPlacement">
        <MudIconButton Class="@Class"
                       Color="@Color"
                       OnClick="@OnClick"
                       ChildContent="@ChildContent"
                       Style="@Style"
                       Icon="@Icon"
                       Size="@Size"
                       Disabled="@Disabled"
                       Variant="@Variant"
                       aria-label="@AccessibleName" />
    </MudTooltip>
}
else
{
    <MudIconButton Class="@Class"
                   Color="@Color"
                   OnClick="@OnClick"
                   ChildContent="@ChildContent"
                   Style="@Style"
                   Icon="@Icon"
                   Size="@Size"
                   Disabled="@Disabled"
                   Variant="@Variant"
                   aria-label="@AccessibleName" />
}


@code {
    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; } = default;

    [Parameter]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public Variant Variant { get; set; }

    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    [Parameter]
    public string Tooltip { get; set; } = "";

    /// <summary>
    /// Where the tooltip opens. A button at the top of a panel can move it aside so it doesn't cover the content below.
    /// </summary>
    [Parameter]
    public Placement TooltipPlacement { get; set; } = Placement.Bottom;

    /// <summary>
    /// The button's accessible name. Icon-only buttons otherwise announce their icon ligature,
    /// so this falls back to <see cref="Tooltip"/> when not set.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    private string? AccessibleName =>
        !string.IsNullOrWhiteSpace(AriaLabel) ? AriaLabel
        : !string.IsNullOrWhiteSpace(Tooltip) ? Tooltip
        : null;
}
