@* A native title keeps the full value on hover; a tooltip wrapper can't shrink in the row, so long values wrapped and clipped. *@
<div class="kv-row">
    <span class="kv-key">@Key</span>
    <span class="kv-value" title="@Value">@Value</span>
</div>

@code {
    [Parameter] public string Key { get; set; } = default!;

    [Parameter] public string Value { get; set; } = default!;
}