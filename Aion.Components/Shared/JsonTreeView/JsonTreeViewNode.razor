@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Aion.Components.Theme

@if (Node is JsonObject jsonObject)
{
    var properties = Sorted ? jsonObject.OrderBy(x => x.Key).ToList() : jsonObject.ToList();
    foreach (var property in properties)
    {
        @ValueItem(property.Key, property.Value)
    }
}
else if (Node is JsonArray jsonArray)
{
    for (var index = 0; index < jsonArray.Count; index++)
    {
        @ValueItem(index.ToString(CultureInfo.InvariantCulture), jsonArray[index])
    }
}

@code {
    /// <summary>
    /// Gets or sets the node to display (including children).
    /// </summary>
    [Parameter]
    [EditorRequired]
    public required JsonNode Node { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether items are sorted by key.
    /// </summary>
    [Parameter]
    public bool Sorted { get; set; }

    // Object properties and array elements render the same way, so arrays and objects nest at any depth.
    private RenderFragment ValueItem(string key, JsonNode? value) => @<text>
        @switch (value)
        {
            case null:
                <JsonTreeViewItem Key="@key" Value="null" Icon="@AionIcons.JsonNull" />
                break;
            case JsonArray array:
                <JsonTreeViewItem Nested="true" Key="@key" Value="@($"Array {array.Count}")" Icon="@AionIcons.JsonArray">
                    <JsonTreeViewNode Node="@array" Sorted="@Sorted" />
                </JsonTreeViewItem>
                break;
            case JsonObject obj when obj.Count == 0:
                <JsonTreeViewItem Key="@key" Value="Object Empty" Icon="@AionIcons.PrettyJson" />
                break;
            case JsonObject obj:
                <JsonTreeViewItem Nested="true" Key="@key" Value="@($"Object {obj.Count}")" Icon="@AionIcons.PrettyJson">
                    <JsonTreeViewNode Node="@obj" Sorted="@Sorted" />
                </JsonTreeViewItem>
                break;
            case JsonValue primitive:
                @PrimitiveItem(key, primitive)
                break;
        }
    </text>;

    private RenderFragment PrimitiveItem(string key, JsonValue value)
    {
        switch (value.GetValueKind())
        {
            case JsonValueKind.String:
                var text = value.GetValue<string>();
                // Result cells serialize SQL NULL as the string "null", so it reads as null here too.
                if (text == "null")
                    return @<JsonTreeViewItem Key="@key" Value="null" Icon="@AionIcons.JsonNull" />;
                if (DateTime.TryParse(text, out var date))
                    return @<JsonTreeViewItem Key="@key" Value="@date.ToString()" Icon="@AionIcons.JsonDate" />;
                if (Guid.TryParse(text, out _))
                    return @<JsonTreeViewItem Key="@key" Value="@text" Icon="@AionIcons.Key" />;
                return @<JsonTreeViewItem Key="@key" Value="@text" Icon="@AionIcons.JsonText" />;
            case JsonValueKind.Number:
                // The JSON text keeps the exact digits, where parsing into float or decimal can round them.
                return @<JsonTreeViewItem Key="@key" Value="@value.ToJsonString()" Icon="@AionIcons.JsonNumber" />;
            case JsonValueKind.True:
                return @<JsonTreeViewItem Key="@key" Value="true" Icon="@AionIcons.Success" />;
            case JsonValueKind.False:
                return @<JsonTreeViewItem Key="@key" Value="false" Icon="@AionIcons.Close" />;
            default:
                return @<JsonTreeViewItem Key="@key" Value="null" Icon="@AionIcons.JsonNull" />;
        }
    }
}
