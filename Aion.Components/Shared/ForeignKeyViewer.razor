@using System.Text.Json
@using Aion.Components.ForeignKeys
@using Aion.Components.RequestContextPanel
@using Aion.Components.Theme
@using MudBlazor.State
@inherits ComponentBaseWithState
@implements IDisposable

<MudStack AlignItems="AlignItems.Center" Row="true" Spacing="3" Class="px-4 overflow-y-auto">
    <MudStack Spacing="0">
        <MudText Typo="Typo.caption">Foreign Key</MudText>
        <MudText Class="mud-text-secondary">@Detail?.SourceColumn → @Detail?.ReferencedTableDisplayName.@Detail?.ReferencedColumn</MudText>
    </MudStack>
    <MudSpacer/>
    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Detail?.ForeignKeyValue</MudChip>

    @if (ShowExpandButton)
    {
        <AionIconButton Class="mr-4" Tooltip="Open related rows in a new tab" OnClick="OnExpand" Icon="@AionIcons.OpenInNew"/>
    }
</MudStack>

@if (Choices.Count > 1)
{
    <MudStack Class="px-4 pt-2">
        <MudSelect T="string"
                   Value="@Detail?.SourceColumn"
                   ValueChanged="OnChoiceChanged"
                   Label="Select Foreign Key"
                   Dense="true"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined">
            @foreach (var choice in Choices)
            {
                <MudSelectItem Value="@choice.SourceColumn">
                    @choice.SourceColumn → @choice.ReferencedTableDisplayName
                </MudSelectItem>
            }
        </MudSelect>
    </MudStack>
}

<MudStack Class="pa-2 h-100 w-100">
    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="h-100">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Loading referenced row...</MudText>
        </MudStack>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="ma-2 fk-viewer-error">@_error</MudAlert>
    }
    else if (!string.IsNullOrEmpty(_rowJson))
    {
        <JsonViewer @ref="_jsonViewer"
                    Json="@_rowJson"
                    ViewMode="@_viewMode"
                    ColumnName="@Detail?.ReferencedTable"
                    ShowExpandButton="false"
                    ViewModeChanged="@((mode) => { _viewMode = mode; StateHasChanged(); })" />
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">No data available</MudText>
    }
</MudStack>

@code {
    [Inject] private IForeignKeyService ForeignKeyService { get; set; } = default!;

    [Parameter] public ForeignKeyDetail? Detail { get; set; }

    /// <summary>
    /// Every foreign key of the row the detail came from, each with that row's own value, so switching between
    /// them never looks up one column's value in another column's table.
    /// </summary>
    [Parameter] public IReadOnlyList<ForeignKeyDetail> Choices { get; set; } = [];

    [Parameter] public bool ShowExpandButton { get; set; } = true;
    [Parameter] public EventCallback OnExpandClick { get; set; }
    [Parameter] public EventCallback<ForeignKeyDetail> OnForeignKeyChanged { get; set; }

    private JsonViewer? _jsonViewer;
    private bool _isLoading;
    private string? _error;
    private string? _rowJson;
    private string _viewMode = "pretty";
    private CancellationTokenSource? _fetch;

    public ForeignKeyViewer()
    {
        using var registerScope = CreateRegisterScope();
        // Any change counts, the value included: the same column in another row points at another row.
        registerScope.RegisterParameter<ForeignKeyDetail?>(nameof(Detail))
            .WithParameter(() => Detail)
            .WithChangeHandler(FetchReferencedRow);
    }

    private async Task FetchReferencedRow()
    {
        if (_fetch is not null)
        {
            await _fetch.CancelAsync();
            _fetch.Dispose();
        }

        var detail = Detail;
        _rowJson = null;
        _error = null;

        if (detail is null)
        {
            _fetch = null;
            _isLoading = false;
            StateHasChanged();
            return;
        }

        var fetch = _fetch = new CancellationTokenSource();
        _isLoading = true;
        StateHasChanged();

        ForeignKeyLookup lookup;
        try
        {
            lookup = await ForeignKeyService.FetchReferencedRowAsync(detail, fetch.Token);
        }
        catch (OperationCanceledException) when (fetch.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            lookup = new ForeignKeyLookup(null, ex.Message);
        }

        // A newer detail arrived while this one was loading; its own fetch owns the view now.
        if (fetch.IsCancellationRequested)
            return;

        _isLoading = false;
        if (lookup.Error is not null)
        {
            _error = $"Failed to fetch referenced row: {lookup.Error}";
        }
        else if (lookup.Row is null)
        {
            _error = $"No row found in {detail.ReferencedTableDisplayName} where {detail.ReferencedColumn} = {detail.ForeignKeyValue}";
        }
        else
        {
            _rowJson = JsonSerializer.Serialize(lookup.Row, new JsonSerializerOptions { WriteIndented = true });
        }

        StateHasChanged();
    }

    private async Task OnChoiceChanged(string column)
    {
        var choice = Choices.FirstOrDefault(c => c.SourceColumn == column);
        if (choice != null)
        {
            await OnForeignKeyChanged.InvokeAsync(choice);
        }
    }

    private async Task OnExpand()
    {
        await OnExpandClick.InvokeAsync();
    }

    public void ReInitialize()
    {
        _jsonViewer?.ReInitializeTree();
    }

    public void Dispose()
    {
        _fetch?.Cancel();
        _fetch?.Dispose();
    }
}
