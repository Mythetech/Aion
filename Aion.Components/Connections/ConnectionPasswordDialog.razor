@using Aion.Components.Connections.Secrets
@using Aion.Components.Shared
@using Aion.Contracts.Connections
@using Aion.Contracts.Database

<MudDialog Class="aion-transparent-dialog">
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="my-2 password-prompt-error">@_error</MudAlert>
        }
        <MudForm @ref="_form">
            <MudStack>
                <MudText Typo="Typo.body2" Class="password-prompt-reason">
                    @(Connection?.LastError ?? ConnectionState.PasswordNotStoredReason)
                </MudText>

                <MudTextField @bind-Value="_password"
                              @ref="_input"
                              Label="@PasswordLabel"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Password is required"
                              OnKeyDown="OnKeyDown" />

                <PasswordStorageChoice @bind-Value="_choice" CurrentStore="@Connection?.PasswordStore" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isConnecting">Cancel</MudButton>
        <PrimaryActionButton OnClick="Submit"
                             Text="Connect"
                             Loading="@_isConnecting"
                             LoadingText="Connecting" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid ConnectionId { get; set; }

    [Inject] private ConnectionState ConnectionState { get; set; } = default!;

    private MudForm? _form;
    private MudTextField<string>? _input;
    private string _password = "";
    private PasswordChoice _choice;
    private string? _error;
    private bool _isConnecting;

    private ConnectionModel? Connection => ConnectionState.Connections.FirstOrDefault(c => c.Id == ConnectionId);

    private string PasswordLabel => Connection?.Type == DatabaseType.LiteDB ? "Encryption Password" : "Password";

    protected override void OnInitialized()
    {
        // A password that was stored but couldn't be read was meant to be kept, so that stays the choice.
        _choice = Connection?.PasswordStore != null ? PasswordChoice.Store : PasswordChoice.DontStore;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _input != null)
        {
            await _input.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Submit();
        }
    }

    private async Task Submit()
    {
        if (_form == null || _isConnecting) return;

        _error = null;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isConnecting = true;
        StateHasChanged();

        try
        {
            var result = await ConnectionState.ConnectWithPasswordAsync(ConnectionId, _password, _choice);
            if (!result.Success)
            {
                _error = result.Error ?? "Could not connect to the server.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
