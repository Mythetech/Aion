@using Aion.Components.Connections.Secrets

@* Whether a connection's password goes to the active secret manager or is asked for when connecting. *@
<div class="password-storage">
    <MudRadioGroup T="PasswordChoice" Value="@Value" ValueChanged="@ValueChanged" aria-label="Password storage">
        <MudRadio T="PasswordChoice" Value="PasswordChoice.Store" Color="Color.Primary" Dense="true"
                  Disabled="@(SecretStore.ActiveStoreName == null)">@StoreLabel</MudRadio>
        <MudRadio T="PasswordChoice" Value="PasswordChoice.DontStore" Color="Color.Primary" Dense="true">
            Don't store (ask when connecting)
        </MudRadio>
    </MudRadioGroup>
    @foreach (var hint in Hints)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="password-storage-hint">@hint</MudText>
    }
</div>

@code {
    [Inject] private IConnectionSecretStore SecretStore { get; set; } = default!;

    [Parameter] public PasswordChoice Value { get; set; }

    [Parameter] public EventCallback<PasswordChoice> ValueChanged { get; set; }

    /// <summary>
    /// Where the connection's password is stored now, when it is.
    /// </summary>
    [Parameter] public string? CurrentStore { get; set; }

    private string StoreLabel => SecretStore.ActiveStoreName is { } store ? $"Store in {store}" : "Store the password";

    private IEnumerable<string> Hints
    {
        get
        {
            var active = SecretStore.ActiveStoreName;

            if (CurrentStore != null)
            {
                yield return active != null && !active.Equals(CurrentStore, StringComparison.OrdinalIgnoreCase)
                    ? $"Stored in {CurrentStore}; saving moves it to {active}"
                    : $"Stored in {CurrentStore}";
            }

            if (active == null)
            {
                yield return $"{SecretStore.UnavailableReason}. Choose another in Tools > Secret Manager.";
            }
        }
    }
}
