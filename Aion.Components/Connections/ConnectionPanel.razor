@using Aion.Components.Connections.Commands
@using Aion.Components.Connections.Events
@using Aion.Components.Querying
@using Aion.Contracts.Connections
@using Aion.Contracts.Database
@using Aion.Components.Shared
@using Aion.Components.Shared.Snackbar
@using Aion.Components.Theme
@using Mythetech.Framework.Infrastructure.MessageBus
@using Aion.Components.Querying.Commands
@using Aion.Components.Shared.Dialogs
@using Aion.Components.Settings.Domains
@using Aion.Contracts.Queries
@implements IConsumer<Aion.Components.Connections.Commands.ExpandDatabase>
@implements IConsumer<Aion.Components.Connections.Commands.ExpandTable>
@implements IConsumer<Aion.Components.Connections.Events.ConnectionHealthChanged>

@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Class="w-100" Spacing="0">
    <h3 class="text-truncate">@Connection.Name</h3>
    <MudSpacer />
    @if (Connection.HealthStatus == ConnectionHealthStatus.Checking || _isRefreshing)
    {
        <MudChip Size="Size.Small" Variant="Variant.Text" T="string" Color="Color.Default">
            <span class="health-spinner"><MudProgressCircular Size="Size.Small" Indeterminate="true" /></span>
            Checking
        </MudChip>
    }
    else if (Connection.Active)
    {
        <MudChip Size="Size.Small" Variant="Variant.Text" T="string" Color="Color.Success">Connected</MudChip>
    }
    else
    {
        <MudTooltip Text="@GetConnectionErrorTooltip()">
            <MudChip Size="Size.Small" Variant="Variant.Text" T="string" Color="Color.Error" OnClick="RefreshConnection">
                Disconnected</MudChip>
            </MudTooltip>
        }
    </MudStack>

    <div class="connection-actions">
        <AionIconButton Icon="@AionIcons.Query" Tooltip="New Query" Size="Size.Small" OnClick="NewQuery" />
        <AionIconButton Icon="@AionIcons.Edit" Tooltip="Edit Connection" Size="Size.Small" OnClick="EditConnection" />
        <AionIconButton Icon="@AionIcons.Refresh" Tooltip="Refresh Connection" Size="Size.Small" OnClick="RefreshConnection"
                        Disabled="@_isRefreshing" />
        <AionIconButton Icon="@AionIcons.Delete" Tooltip="Delete Connection" Size="Size.Small" Color="Color.Error"
                        OnClick="DeleteConnection" />
    </div>

    <MudStack Row="true" AlignItems="AlignItems.Center">
        <h6>@ConnectionDescription.EngineLabel(Connection.Type)</h6>
        <MudSpacer />
        @if (ConnectionState.SupportsCreatingDatabases(Connection.Type))
        {
            <AionIconButton Icon="@AionIcons.Add" Tooltip="Add Database" OnClick="AddDatabase" />
        }
    </MudStack>

    <div class="schema-filter">
        <MudTextField T="string" Value="@_filterText" ValueChanged="OnFilterChanged" OnKeyDown="OnFilterKeyDown"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="150"
                      Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@AionIcons.Search"
                      Placeholder="Filter tables and columns" />
    </div>

    <div class="schema-tree">
    <MudTreeView T="string" Hover="true" Dense="true" ExpandOnClick="true" Class="h-100 mb-4">
        @if (Connection.Databases.Count == 0)
        {
            <SchemaStatusItem Value="@($"{Connection.Id}/databases")" State="@DatabasesState" IsEmpty="true"
                              EmptyText="No databases" OnRetry="RefreshConnection" />
        }

        @foreach (var database in Connection.Databases)
        {
            var tablesKey = $"{database.Name}/Tables";
            var indexesKey = $"{database.Name}/Indexes";
            var functionsKey = $"{database.Name}/Functions";
            var viewsKey = $"{database.Name}/Views";
            var visibleTables = database.TablesState.IsLoaded ? WithoutSystemSchemas(database.Tables) : [];
            var tableMatches = _filter.Apply(visibleTables, database);
            var visibleViews = database.ViewsState.IsLoaded ? WithoutSystemSchemas(database.Views) : [];
            var viewMatches = _filter.Apply(visibleViews, database);

            <MudTreeViewItem @key="database.Name" Text="@database.Name" Value="@database.Name" @ref="_databases[database.Name]"
                             Icon="@AionIcons.Connection"
                             Expanded="@(_openDatabases.Contains(database.Name) || (_filter.IsActive && tableMatches.Count + viewMatches.Count > 0))"
                             ExpandedChanged="@(open => OnDatabaseExpandedChanged(database, open))">
                @* Database level *@
                <BodyContent Context="ctx">
                    <div class="d-flex align-center justify-space-between w-100">
                        <div class="d-flex align-center">
                            <MudText>@database.Name</MudText>
                        </div>
                        <div>
                            <AionMenu AnchorOrigin="Origin.BottomRight">
                                <ActivatorContent>
                                    <MudIconButton Size="Size.Small" Icon="@AionIcons.More"
                                                   aria-label="@($"{database.Name} actions")"
                                                   OnClick="@context.ToggleAsync" />
                                </ActivatorContent>
                                <ChildContent>
                                    @if (ConnectionState.SupportsCreatingTables(Connection.Type))
                                    {
                                        <MudMenuItem OnClick="@(() => CreateTable(database))">Create Table</MudMenuItem>
                                    }
                                    <MudMenuItem OnClick="@(() => RefreshSchema(database))">Refresh</MudMenuItem>
                                </ChildContent>
                            </AionMenu>
                        </div>
                    </div>
                </BodyContent>

                @* Tables level *@
                <ChildContent>
                    <MudTreeViewItem Text="Tables" Value="@tablesKey" Icon="@AionIcons.Table"
                                     EndText="@GroupCount(database.TablesState, tableMatches.Count, visibleTables.Count)"
                                     EndTextTypo="Typo.caption" EndTextClass="tree-group-count"
                                     Expanded="@(IsExpanded(tablesKey, database.TablesState) || (_filter.IsActive && tableMatches.Count > 0))"
                                     ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(tablesKey, expanded, () => LoadTables(database)))">
                        <SchemaStatusItem Value="@($"{tablesKey}/status")" State="@database.TablesState"
                                          IsEmpty="@(tableMatches.Count == 0)" EmptyText="@(_filter.IsActive ? "No tables match" : "No tables")"
                                          OnRetry="@(() => LoadTables(database))" />

                        @foreach (var match in tableMatches)
                        {
                            var table = match.Table;
                            var tableKey = TableKey(database, table);
                            var columnsState = database.ColumnsState(table.DisplayName);

                            <MudTreeViewItem @key="tableKey" Text="@table.DisplayName" Value="@tableKey" Icon="@AionIcons.Table"
                                             Expanded="@(match.MatchedByColumns || IsExpanded(tableKey, columnsState))"
                                             ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(tableKey, expanded, () => LoadColumns(database, table)))">
                                <BodyContent Context="ctx">
                                    <div class="relation-row">
                                        <MudText Typo="Typo.body2" Class="relation-name" title="@table.DisplayName">@table.DisplayName</MudText>
                                        @if (table.RowCount is { } rowCount)
                                        {
                                            <span class="row-count" title="@RowCountText.Describe(rowCount)">@RowCountText.Short(rowCount)</span>
                                        }
                                        <div class="relation-actions">
                                            <AionMenu AnchorOrigin="Origin.BottomRight">
                                                <ActivatorContent>
                                                    <MudIconButton Size="Size.Small" Icon="@AionIcons.More"
                                                                   aria-label="@($"{table.DisplayName} actions")"
                                                                   OnClick="@context.ToggleAsync" />
                                                </ActivatorContent>
                                                <ChildContent>
                                                    <MudMenuItem OnClick="@(() => OpenFirstRows(database.Name, table))">Select first 1000 rows</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => EditData(database.Name, table))">Edit Data</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => GenerateData(database, table))">Generate Data</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => RefreshSchema(database))">Refresh</MudMenuItem>
                                                </ChildContent>
                                            </AionMenu>
                                        </div>
                                    </div>
                                </BodyContent>

                                @* Columns, then the table's indexes and foreign keys. A table the filter kept for its
                                   columns lists only those, since the groups would only push them apart. *@
                                <ChildContent>
                                    @if (match.MatchedByColumns)
                                    {
                                        @ColumnRows(tableKey, match.MatchingColumns!)
                                    }
                                    else
                                    {
                                        @RelationContents(database, table, tableKey, columnsState, withTableGroups: true)
                                    }
                                </ChildContent>
                            </MudTreeViewItem>
                        }
                    </MudTreeViewItem>

                    @* Views level *@
                    @if (ConnectionState.SupportsViews(Connection.Type))
                    {
                        <MudTreeViewItem Text="Views" Value="@viewsKey" Icon="@AionIcons.View"
                                         EndText="@GroupCount(database.ViewsState, viewMatches.Count, visibleViews.Count)"
                                         EndTextTypo="Typo.caption" EndTextClass="tree-group-count"
                                         Expanded="@(IsExpanded(viewsKey, database.ViewsState) || (_filter.IsActive && viewMatches.Count > 0))"
                                         ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(viewsKey, expanded, () => LoadViews(database)))">
                            <SchemaStatusItem Value="@($"{viewsKey}/status")" State="@database.ViewsState"
                                              IsEmpty="@(viewMatches.Count == 0)" EmptyText="@(_filter.IsActive ? "No views match" : "No views")"
                                              OnRetry="@(() => LoadViews(database))" />

                            @foreach (var match in viewMatches)
                            {
                                var view = match.Table;
                                var viewKey = $"{viewsKey}|{view.DisplayName}";
                                var columnsState = database.ColumnsState(view.DisplayName);

                                <MudTreeViewItem @key="viewKey" Value="@viewKey" Icon="@AionIcons.View"
                                                 Expanded="@(match.MatchedByColumns || IsExpanded(viewKey, columnsState))"
                                                 ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(viewKey, expanded, () => LoadColumns(database, view)))">
                                    <BodyContent Context="ctx">
                                        <div class="relation-row">
                                            <MudText Typo="Typo.body2" Class="relation-name" title="@view.DisplayName">@view.DisplayName</MudText>
                                            <div class="relation-actions">
                                                <AionMenu AnchorOrigin="Origin.BottomRight">
                                                    <ActivatorContent>
                                                        <MudIconButton Size="Size.Small" Icon="@AionIcons.More"
                                                                       aria-label="@($"{view.DisplayName} actions")"
                                                                       OnClick="@context.ToggleAsync" />
                                                    </ActivatorContent>
                                                    <ChildContent>
                                                        <MudMenuItem OnClick="@(() => OpenFirstRows(database.Name, view))">Select first 1000 rows</MudMenuItem>
                                                        <MudMenuItem OnClick="@(() => RefreshSchema(database))">Refresh</MudMenuItem>
                                                    </ChildContent>
                                                </AionMenu>
                                            </div>
                                        </div>
                                    </BodyContent>

                                    <ChildContent>
                                        @if (match.MatchedByColumns)
                                        {
                                            @ColumnRows(viewKey, match.MatchingColumns!)
                                        }
                                        else
                                        {
                                            @RelationContents(database, view, viewKey, columnsState, withTableGroups: false)
                                        }
                                    </ChildContent>
                                </MudTreeViewItem>
                            }
                        </MudTreeViewItem>
                    }

                    @* Indexes level *@
                    @if (ConnectionState.SupportsIndexes(Connection.Type))
                    {
                        <MudTreeViewItem Text="Indexes" Value="@indexesKey" Icon="@AionIcons.Index"
                                         Expanded="@IsExpanded(indexesKey, database.IndexesState)"
                                         ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(indexesKey, expanded, () => LoadIndexes(database)))">
                            <SchemaStatusItem Value="@($"{indexesKey}/status")" State="@database.IndexesState"
                                              IsEmpty="@(database.Indexes.Count == 0)" EmptyText="No indexes"
                                              OnRetry="@(() => LoadIndexes(database))" />

                            @if (database.IndexesState.IsLoaded)
                            {
                                @foreach (var idx in database.Indexes)
                                {
                                    <MudTreeViewItem @key="idx.DisplayName" Value="@($"{indexesKey}/{idx.DisplayName}")"
                                                     Icon="@(idx.IsPrimary ? AionIcons.PrimaryKey : AionIcons.Index)"
                                                     IconColor="@(idx.IsPrimary ? Color.Warning : Color.Default)">
                                        <BodyContent Context="ctx">
                                            <div class="tree-row detail-row" title="@IndexDescription(idx)">
                                                <span class="tree-row-name">@idx.DisplayName</span>
                                                <span class="tree-detail">@string.Join(", ", idx.Columns)</span>
                                            </div>
                                        </BodyContent>
                                    </MudTreeViewItem>
                                }
                            }
                        </MudTreeViewItem>
                    }

                    @* Functions level *@
                    @if (ConnectionState.SupportsRoutines(Connection.Type))
                    {
                        <MudTreeViewItem Text="Functions" Value="@functionsKey" Icon="@AionIcons.Function"
                                         Expanded="@IsExpanded(functionsKey, database.RoutinesState)"
                                         ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(functionsKey, expanded, () => LoadRoutines(database)))">
                            <SchemaStatusItem Value="@($"{functionsKey}/status")" State="@database.RoutinesState"
                                              IsEmpty="@(database.Routines.Count == 0)" EmptyText="No functions"
                                              OnRetry="@(() => LoadRoutines(database))" />

                            @if (database.RoutinesState.IsLoaded)
                            {
                                @foreach (var routine in database.Routines)
                                {
                                    var routineKey = $"{functionsKey}/{routine.DisplayName}{routine.ArgumentSignature}";
                                    <MudTreeViewItem @key="routineKey" Value="@routineKey" Icon="@AionIcons.Function">
                                        <BodyContent Context="ctx">
                                            <div class="tree-row detail-row" title="@RoutineSignature(routine)">
                                                <span class="tree-row-name">@routine.DisplayName</span>
                                                <span class="tree-detail">@RoutineSignature(routine)</span>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                         Color="@(routine.Kind == RoutineKind.Function ? Color.Info : Color.Warning)"
                                                         Class="ml-2">
                                                    @routine.Kind.ToString().ToUpperInvariant()
                                                </MudChip>
                                            </div>
                                        </BodyContent>
                                    </MudTreeViewItem>
                                }
                            }
                        </MudTreeViewItem>
                    }
                </ChildContent>
            </MudTreeViewItem>
        }
    </MudTreeView>
    </div>

@code {
    [Parameter] public ConnectionModel Connection { get; set; } = default!;
    [Inject] public ConnectionState ConnectionState { get; set; } = default!;
    [Inject] public QueryState QueryState { get; set; } = default!;
    [Inject] protected ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private IMessageBus MessageBus { get; set; } = default!;
    [Inject] private BrowserSettings BrowserSettings { get; set; } = default!;

    private Dictionary<string, MudTreeViewItem<string>> _databases = new();

    // Tree values of the lazily loaded items the user has open. An item only renders open while its load has
    // at least started, so a refresh that drops loaded data closes it instead of leaving it spinning.
    private readonly HashSet<string> _expanded = [];

    // Databases the user has open. While a filter is active, databases with matches also show open, and
    // clearing the filter falls back to this set, so the tree returns to the shape the user left it in.
    private readonly HashSet<string> _openDatabases = [];

    // The text as typed; the filter trims it, and binding the field to the trimmed text would drop a space mid-word.
    private string _filterText = "";
    private SchemaTreeFilter _filter = new("");
    private bool _isRefreshing;

    private static string TableKey(DatabaseModel database, TableInfo table) => $"{database.Name}|{table.DisplayName}";

    private bool IsExpanded(string key, SchemaLoadState state) =>
        _expanded.Contains(key) && state.Status != SchemaLoadStatus.NotLoaded;

    private string? GroupCount(SchemaLoadState state, int shown, int total) =>
        !state.IsLoaded ? null
        : _filter.IsActive ? $"{shown} of {total}"
        : total.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private void OnDatabaseExpandedChanged(DatabaseModel database, bool open)
    {
        if (open)
            _openDatabases.Add(database.Name);
        else
            _openDatabases.Remove(database.Name);
    }

    private async Task OnFilterChanged(string? text)
    {
        _filterText = text ?? "";
        _filter = new SchemaTreeFilter(_filterText);

        if (_filter.IsActive)
            await LoadTablesToFilterAsync();
    }

    private void OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;

        _filterText = "";
        _filter = new SchemaTreeFilter("");
    }

    // The filter only reads what is loaded, so it lists the tables and views of the databases it can show: the only one,
    // or the ones open in the tree. Other databases on a server are left alone so typing never queries them all.
    private async Task LoadTablesToFilterAsync()
    {
        var databases = Connection.Databases.Count == 1
            ? Connection.Databases.ToList()
            : Connection.Databases.Where(database => _openDatabases.Contains(database.Name)).ToList();

        foreach (var database in databases.Where(database => database.TablesState.Status == SchemaLoadStatus.NotLoaded))
        {
            await LoadTables(database);
        }
    }

    private RenderFragment ColumnRows(string tableKey, IReadOnlyList<ColumnInfo> columns) => @<text>
        @foreach (var column in columns)
        {
            <MudTreeViewItem @key="column.Name" Value="@($"{tableKey}/column/{column.Name}")"
                             Icon="@ColumnIcon(column)" IconColor="@ColumnIconColor(column)">
                <BodyContent Context="ctx">
                    @* A native title keeps hover detail cheap: a MudTooltip per row would register a popover for every column. *@
                    <div class="tree-row column-row" title="@ColumnTypeText.Describe(column, Connection.Type)">
                        <span class="tree-row-name">@column.Name</span>
                        <span class="column-type">@ColumnTypeText.Short(column, Connection.Type)@if (column.IsNullable){<span class="column-nullable">?</span>}</span>
                    </div>
                </BodyContent>
            </MudTreeViewItem>
        }
    </text>;

    // Columns, then for a table its indexes and foreign keys. Views have neither.
    private RenderFragment RelationContents(DatabaseModel database, TableInfo table, string tableKey, SchemaLoadState columnsState, bool withTableGroups)
    {
        var columns = columnsState.IsLoaded ? database.TableColumns.GetValueOrDefault(table.DisplayName) ?? [] : [];

        return @<text>
            <SchemaStatusItem Value="@($"{tableKey}/status")" State="@columnsState"
                              IsEmpty="@(columns.Count == 0)" EmptyText="No columns"
                              OnRetry="@(() => LoadColumns(database, table))" />

            @if (columnsState.IsLoaded)
            {
                @ColumnRows(tableKey, columns)
            }

            @if (columnsState.IsLoaded && withTableGroups)
            {
                @if (ConnectionState.SupportsIndexes(Connection.Type))
                {
                    var tableIndexesKey = $"{tableKey}/indexes";
                    var indexes = database.IndexesState.IsLoaded ? IndexesFor(database, table) : null;
                    <MudTreeViewItem @key="tableIndexesKey" Value="@tableIndexesKey" Icon="@AionIcons.Index"
                                     Expanded="@IsExpanded(tableIndexesKey, database.IndexesState)"
                                     ExpandedChanged="@(expanded => OnLazyItemExpandedChanged(tableIndexesKey, expanded, () => LoadIndexes(database)))"
                                     ChildContent="@(indexes is { Count: 0 } ? null : IndexRows(database, tableIndexesKey, indexes))">
                        <BodyContent Context="ctx">
                            <div class="tree-row">
                                <span class="tree-group-label">Indexes</span>
                                @if (indexes is not null)
                                {
                                    <span class="tree-count">@indexes.Count</span>
                                }
                            </div>
                        </BodyContent>
                    </MudTreeViewItem>
                }

                var foreignKeys = columns.Where(c => c.IsForeignKey).ToList();
                var foreignKeysKey = $"{tableKey}/foreign-keys";
                <MudTreeViewItem @key="foreignKeysKey" Value="@foreignKeysKey" Icon="@AionIcons.ForeignKey"
                                 ChildContent="@(foreignKeys.Count == 0 ? null : ForeignKeyRows(tableKey, foreignKeys))">
                    <BodyContent Context="ctx">
                        <div class="tree-row">
                            <span class="tree-group-label">Foreign keys</span>
                            <span class="tree-count">@foreignKeys.Count</span>
                        </div>
                    </BodyContent>
                </MudTreeViewItem>
            }
        </text>;
    }

    private SchemaLoadState DatabasesState =>
        _isRefreshing || Connection.HealthStatus == ConnectionHealthStatus.Checking ? SchemaLoadState.Loading
        : Connection.Active ? SchemaLoadState.Loaded
        : SchemaLoadState.Failed(GetConnectionErrorTooltip());

    private async Task OnLazyItemExpandedChanged(string key, bool expanded, Func<Task> load)
    {
        if (!expanded)
        {
            _expanded.Remove(key);
            return;
        }

        _expanded.Add(key);
        await load();
    }

    // MySQL lists tables without a schema but tags each index with its database name, so the schema
    // only narrows the match when the table has one.
    private static List<IndexInfo> IndexesFor(DatabaseModel database, TableInfo table) =>
        database.Indexes
            .Where(index => index.TableName == table.Name
                            && (string.IsNullOrEmpty(table.Schema) || index.TableSchema == table.Schema))
            .ToList();

    private RenderFragment IndexRows(DatabaseModel database, string groupKey, List<IndexInfo>? indexes) => @<text>
        @if (indexes is null)
        {
            <SchemaStatusItem Value="@($"{groupKey}/status")" State="@database.IndexesState"
                              OnRetry="@(() => LoadIndexes(database))" />
        }
        else
        {
            @foreach (var index in indexes)
            {
                <MudTreeViewItem @key="index.Name" Value="@($"{groupKey}/{index.Name}")"
                                 Icon="@(index.IsPrimary ? AionIcons.PrimaryKey : AionIcons.Index)"
                                 IconColor="@(index.IsPrimary ? Color.Warning : Color.Default)">
                    <BodyContent Context="ctx">
                        <div class="tree-row detail-row" title="@IndexDescription(index)">
                            <span class="tree-row-name">@index.Name</span>
                            <span class="tree-detail">@string.Join(", ", index.Columns)</span>
                        </div>
                    </BodyContent>
                </MudTreeViewItem>
            }
        }
    </text>;

    private RenderFragment ForeignKeyRows(string tableKey, List<ColumnInfo> columns) => @<text>
        @foreach (var column in columns)
        {
            var foreignKey = column.ForeignKey!;
            <MudTreeViewItem Value="@($"{tableKey}/foreign-keys/{foreignKey.ConstraintName}/{column.Name}")"
                             Icon="@AionIcons.ForeignKey">
                <BodyContent Context="ctx">
                    <div class="tree-row detail-row" title="@ColumnTypeText.Describe(column, Connection.Type)">
                        <span class="tree-row-name">@column.Name</span>
                        <span class="tree-detail">@foreignKey.ReferencedTable.@foreignKey.ReferencedColumn</span>
                    </div>
                </BodyContent>
            </MudTreeViewItem>
        }
    </text>;

    private static string RoutineSignature(RoutineInfo routine) =>
        string.IsNullOrEmpty(routine.ReturnType)
            ? routine.ArgumentSignature ?? ""
            : $"{routine.ArgumentSignature} → {routine.ReturnType}".TrimStart();

    private static string IndexDescription(IndexInfo index)
    {
        var kind = index.IsPrimary ? "primary key" : index.IsUnique ? "unique index" : "index";
        return index.Columns.Count == 0 ? kind : $"{kind} on ({string.Join(", ", index.Columns)})";
    }

    private List<TableInfo> WithoutSystemSchemas(List<TableInfo> relations)
    {
        if (BrowserSettings.ShowSystemTables)
            return relations;

        var systemSchemas = ConnectionState.GetProvider(Connection.Type).SystemSchemas;

        if (systemSchemas.Count == 0)
            return relations;

        return relations.Where(t => !systemSchemas.Contains(t.Schema, StringComparer.OrdinalIgnoreCase)).ToList();
    }

    private static string ColumnIcon(ColumnInfo column) =>
        column.IsPrimaryKey ? AionIcons.PrimaryKey
        : column.IsForeignKey ? AionIcons.ForeignKey
        : AionIcons.Column;

    private static Color ColumnIconColor(ColumnInfo column) => column.IsPrimaryKey ? Color.Warning : Color.Default;

    private string GetConnectionErrorTooltip()
    {
        if (!string.IsNullOrEmpty(Connection.LastError))
            return Connection.LastError;

        return Connection.HealthStatus switch
        {
            ConnectionHealthStatus.Timeout => "Connection timed out",
            ConnectionHealthStatus.Unhealthy => "Connection failed",
            _ => "Click to reconnect"
        };
    }

    private async Task RefreshConnection()
    {
        _isRefreshing = true;
        StateHasChanged();

        try
        {
            var result = await ConnectionState.RefreshDatabaseAsync(Connection);

            if (result.Success)
            {
                Snackbar.AddAionNotification($"Reconnected to {Connection.Name}", Severity.Success);
            }
            else
            {
                Snackbar.AddAionNotification($"Failed to reconnect: {result.Error}", Severity.Error);
            }
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task NewQuery()
    {
        var query = QueryState.AddQuery("Untitled");
        QueryState.UpdateQueryConnection(query, Connection);
        await MessageBus.PublishAsync(new FocusQuery(query));
    }

    private async Task EditConnection()
    {
        await MessageBus.PublishAsync(new PromptCreateConnection(ConnectionDialogModel.ForEdit(Connection)));
    }

    private async Task DeleteConnection()
    {
        await MessageBus.PublishAsync(new Commands.DeleteConnection(Connection.Id));
    }

    private async Task AddDatabase()
    {
        await MessageBus.PublishAsync(new OpenCreateDatabaseTemplate(Connection.Id));
    }

    private async Task CreateTable(DatabaseModel database)
    {
        await MessageBus.PublishAsync(new OpenCreateTableTemplate(Connection.Id, database.Name));
    }

    private async Task OpenFirstRows(string databaseName, TableInfo table)
    {
        await MessageBus.PublishAsync(new OpenTableRows(Connection.Id, databaseName, table.Schema, table.Name));
    }

    private async Task EditData(string databaseName, TableInfo table)
    {
        await MessageBus.PublishAsync(new OpenTableEditor(Connection.Id, databaseName, table.Schema, table.Name));
    }

    private async Task GenerateData(DatabaseModel database, TableInfo table)
    {
        var columnsState = await ConnectionState.LoadColumnsAsync(Connection, database, table.Schema, table.Name);
        if (columnsState.IsFailed)
        {
            Snackbar.AddAionNotification($"Could not read the columns of {table.DisplayName}: {columnsState.Error}", Severity.Error);
            return;
        }

        var columns = database.TableColumns.GetValueOrDefault(table.DisplayName) ?? [];
        if (columns.Count == 0)
        {
            Snackbar.Add("No columns found for table", MudBlazor.Severity.Warning);
            return;
        }

        var provider = ConnectionState.GetProvider(Connection.Type);
        var connString = provider.UpdateConnectionString(Connection.ConnectionString, database.Name);

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackgroundClass = "aion-dialog",
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false
        };
        var parameters = new DialogParameters<Scaffolding.DataGeneration.DataGenerationDialog>
        {
            { x => x.TableName, table.Name },
            { x => x.Schema, table.Schema },
            { x => x.Database, database.Name },
            { x => x.Columns, columns },
            { x => x.Provider, provider },
            { x => x.ConnectionString, connString }
        };
        var dialog = await DialogService.ShowAsync<Scaffolding.DataGeneration.DataGenerationDialog>(
            "Generate Data", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: true })
            await RefreshSchema(database);
    }

    private async Task RefreshSchema(DatabaseModel database)
    {
        await ConnectionState.RefreshSchemaAsync(Connection, database);
    }

    // Views are listed with the tables so the Views group shows its count without being opened.
    private async Task LoadTables(DatabaseModel database)
    {
        await ConnectionState.LoadTablesAsync(Connection, database);

        if (ConnectionState.SupportsViews(Connection.Type) && database.ViewsState.Status == SchemaLoadStatus.NotLoaded)
            await ConnectionState.LoadViewsAsync(Connection, database);
    }

    private async Task LoadViews(DatabaseModel database)
    {
        await ConnectionState.LoadViewsAsync(Connection, database);
    }

    private async Task LoadIndexes(DatabaseModel database)
    {
        await ConnectionState.LoadIndexesAsync(Connection, database);
    }

    private async Task LoadRoutines(DatabaseModel database)
    {
        await ConnectionState.LoadRoutinesAsync(Connection, database);
    }

    private async Task LoadColumns(DatabaseModel database, TableInfo table)
    {
        await ConnectionState.LoadColumnsAsync(Connection, database, table.Schema, table.Name);
    }

    public async Task Consume(ExpandDatabase message)
    {
        await Task.Yield();

        if (_databases.TryGetValue(message.DatabaseName, out var treeview))
        {
            await treeview.ExpandAllAsync();
            await treeview.ReloadAsync();
        }
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        ConnectionState.ConnectionStateChanged += StateHasChanged;
        MessageBus.Subscribe<ExpandDatabase>(this);
        MessageBus.Subscribe<ExpandTable>(this);
        MessageBus.Subscribe<ConnectionHealthChanged>(this);
    }

    public void Dispose()
    {
        ConnectionState.ConnectionStateChanged -= StateHasChanged;
        MessageBus.Unsubscribe<ExpandDatabase>(this);
        MessageBus.Unsubscribe<ExpandTable>(this);
        MessageBus.Unsubscribe<ConnectionHealthChanged>(this);
    }

    public async Task Consume(ConnectionHealthChanged message)
    {
        if (message.ConnectionId != Connection.Id)
            return;

        await InvokeAsync(StateHasChanged);
    }

    public async Task Consume(ExpandTable message)
    {
        await Task.Yield();
        if (_databases.TryGetValue(message.Database.Name, out var treeview))
        {
            await treeview.ExpandAllAsync();
            await treeview.ReloadAsync();
        }

        var table = message.Database.Tables.FirstOrDefault(t => t.DisplayName == message.TableDisplayName);
        if (table != null)
        {
            _expanded.Add(TableKey(message.Database, table));
            await LoadColumns(message.Database, table);
        }

        await InvokeAsync(StateHasChanged);
    }

}
