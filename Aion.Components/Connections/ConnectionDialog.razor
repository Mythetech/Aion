@using Aion.Contracts.Database
@using Aion.Components.Shared
@using Aion.Components.Shared.Loaders
@using Aion.Contracts.Connections
@using Aion.Components.Shared.Switch
@using Mythetech.Framework.Components.SimpleTabs

<MudDialog Class="aion-transparent-dialog">
    <DialogContent>
        @if (!string.IsNullOrEmpty(ValidationError))
        {
            <MudAlert Severity="Severity.Error" Class="my-2 connection-dialog-error">@ValidationError</MudAlert>
        }
        else if (!string.IsNullOrEmpty(_testSuccessMessage))
        {
            <MudAlert Severity="Severity.Success" Class="my-2 connection-dialog-success">@_testSuccessMessage</MudAlert>
        }
        <SimpleTabs>
            <Tab Name="Basic">
                <MudForm Model="@Model" @ref="@_form">
                    <MudStack>
                        <MudTextField @bind-Value="Model.Name"
                                      Label="Connection Name"/>

                        <MudSelect T="DatabaseType"
                                   Value="Model.Type"
                                   ValueChanged="OnTypeChanged"
                                   Label="Database Type"
                                   Required="true"
                                   RequiredError="Database type is required"
                                   Disabled="@IsEditMode">
                            @foreach (var type in ProviderFactory.SupportedDatabases)
                            {
                                <MudSelectItem Value="@type">@type.ToString()</MudSelectItem>
                            }
                        </MudSelect>

                        @if (Model.Type == DatabaseType.LiteDB)
                        {
                            <MudTextField @bind-Value="Model.Host"
                                          Label="Database File Path"
                                          Required="true"
                                          RequiredError="File path is required"
                                          HelperText="Path to the .db file (will be created if it doesn't exist)"/>
                        }
                        else
                        {
                            <MudTextField @bind-Value="Model.Host"
                                          Label="@GetHostLabel()"
                                          Required="true"
                                          RequiredError="Host is required"/>
                        }

                        @if (Model.Type == DatabaseType.SQLServer)
                        {
                            <MudTextField @bind-Value="Model.Instance"
                                          Label="Instance Name (optional)"
                                          HelperText="Leave empty for default instance"/>
                        }

                        @if (Model.Type != DatabaseType.LiteDB)
                        {
                            <MudTextField @bind-Value="Model.Port"
                                          Disabled="@(Model.Type == DatabaseType.SQLServer && !string.IsNullOrEmpty(Model.Instance))"
                                          Label="Port"
                                          Required="true"
                                          RequiredError="Port is required"/>

                            <MudTextField @bind-Value="Model.Database"
                                          Label="Database (optional)"
                                          HelperText="@GetDatabaseHelperText()"/>
                        }

                        @if (Model.Type == DatabaseType.SQLServer)
                        {
                            <AionSwitch T="bool" @bind-Value="Model.UseWindowsAuth"
                                        Color="Color.Primary"
                                        Label="Use Windows Authentication"/>
                            <AionSwitch T="bool" @bind-Value="Model.Encrypt"
                                        Color="Color.Primary"
                                        Label="Encrypt"/>
                            <AionSwitch T="bool" @bind-Value="Model.TrustServerCertificate"
                                        Color="Color.Primary"
                                        Label="Trust Server Certificate"/>
                        }

                        @if (Model.Type == DatabaseType.LiteDB)
                        {
                            <MudTextField @bind-Value="Model.Password"
                                          Label="Encryption Password (optional)"
                                          InputType="InputType.Password"
                                          HelperText="Leave empty for unencrypted database"/>
                        }
                        else if (!UsesWindowsAuth)
                        {
                            <MudTextField @bind-Value="Model.Username"
                                          Label="Username"
                                          Required="true"
                                          RequiredError="Username is required"/>

                            <MudTextField @bind-Value="Model.Password"
                                          Label="Password"
                                          InputType="InputType.Password"/>
                        }
                        <AionSwitch T="bool" @bind-Value="Model.SaveCredentials"
                                    Color="Color.Primary"
                                    Label="Save Credentials"/>

                    </MudStack>
                </MudForm>
            </Tab>
            <Tab Name="Connection String" @ref="_connectionStringTab">
                <MudStack>
                    <MudTextField @bind-Value="Model.Name"
                                  Label="Connection Name"/>

                    <MudTextField @bind-Value="Model.ConnectionString"
                                  Label="Connection String"
                                  Lines="3"
                                  Required="true"
                                  RequiredError="Connection string is required"/>

                    <AionSwitch T="bool" @bind-Value="Model.SaveCredentials"
                                Color="Color.Primary"
                                Label="Save Credentials"/>

                </MudStack>
            </Tab>
        </SimpleTabs>
        @if (Model.SaveCredentials)
        {
        <MudAlert Severity="Severity.Warning">
            <small>
                Warning: Credentials will be stored unencrypted.
                This is intended for local development connections only.
            </small>
        </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="TestConnection" Disabled="@IsBusy" Class="connection-dialog-test">
            @if (_isTesting)
            {
                <span>Testing</span>
                <LoadingDots />
            }
            else
            {
                <span>Test Connection</span>
            }
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel" Disabled="@IsBusy">Cancel</MudButton>
        <PrimaryActionButton OnClick="Submit"
                             Text="@(IsEditMode ? "Save" : "Connect")"
                             Loading="@_isConnecting"
                             Disabled="@_isTesting"
                             LoadingText="@(IsEditMode ? "Saving" : "Connecting")"/>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IDatabaseProviderFactory ProviderFactory { get; set; } = default!;
    [Inject] private ConnectionState ConnectionState { get; set; } = default!;

    [Parameter] public ConnectionDialogModel? InitialValues { get; set; }

    private MudForm? _form;
    private Tab? _connectionStringTab;
    private ConnectionDialogModel Model { get; set; } = new();
    private string? ValidationError { get; set; }
    private string? _testSuccessMessage;
    private bool _isConnecting;
    private bool _isTesting;

    private bool IsEditMode => Model.EditingConnectionId.HasValue;
    private bool IsBusy => _isConnecting || _isTesting;
    private bool UsesWindowsAuth => Model.Type == DatabaseType.SQLServer && Model.UseWindowsAuth;
    private bool IsConnectionStringTabActive => _connectionStringTab?.IsActive == true;

    protected override void OnInitialized()
    {
        if (InitialValues != null)
        {
            Model = InitialValues;
        }

        if (string.IsNullOrEmpty(Model.Host) && !string.IsNullOrWhiteSpace(Model.ConnectionString))
        {
            ConnectionStringComposer.TryPopulate(Model, Model.ConnectionString);
        }

        if (string.IsNullOrEmpty(Model.Port))
        {
            Model.Port = GetDefaultPort(Model.Type);
        }

        base.OnInitialized();
    }

    private string GetDefaultPort(DatabaseType type)
    {
        if (!ProviderFactory.SupportedDatabases.Contains(type))
            return string.Empty;

        return ProviderFactory.GetProvider(type).GetDefaultPort().ToString();
    }

    private string GetHostLabel() => Model.Type switch
    {
        DatabaseType.SQLServer => "Server",
        _ => "Host"
    };

    private string GetDatabaseHelperText() => Model.Type switch
    {
        DatabaseType.PostgreSQL => "Leave empty to connect through the postgres database",
        DatabaseType.SQLServer => "Leave empty to connect through master",
        _ => "Leave empty to list every database you can access"
    };

    private void OnTypeChanged(DatabaseType type)
    {
        var previousDefaultPort = GetDefaultPort(Model.Type);
        Model.Type = type;

        if (string.IsNullOrEmpty(Model.Port) || Model.Port == previousDefaultPort)
        {
            Model.Port = GetDefaultPort(type);
        }

        ClearFeedback();
    }

    private async Task Submit()
    {
        ClearFeedback();

        var connectionString = await PrepareConnectionStringAsync();
        if (connectionString == null)
            return;

        _isConnecting = true;
        StateHasChanged();

        try
        {
            var name = ResolveName(connectionString);

            if (IsEditMode)
            {
                var updated = new ConnectionModel
                {
                    Name = name,
                    ConnectionString = connectionString,
                    Type = Model.Type,
                    SaveCredentials = Model.SaveCredentials
                };

                var result = await ConnectionState.UpdateConnection(Model.EditingConnectionId!.Value, updated);
                if (!result.Success)
                {
                    ValidationError = $"Changes saved, but Aion could not connect: {DescribeFailure(result.Error)}";
                    return;
                }

                MudDialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var connection = new ConnectionModel
                {
                    Name = name,
                    ConnectionString = connectionString,
                    Type = Model.Type,
                    Active = false,
                    SaveCredentials = Model.SaveCredentials
                };

                var result = await ConnectionState.ConnectAsync(connection);
                if (!result.Success)
                {
                    ValidationError = DescribeFailure(result.Error);
                    return;
                }

                MudDialog.Close(DialogResult.Ok(connection));
            }
        }
        catch (Exception ex)
        {
            ValidationError = ex.Message;
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private async Task TestConnection()
    {
        ClearFeedback();

        var connectionString = await PrepareConnectionStringAsync();
        if (connectionString == null)
            return;

        _isTesting = true;
        StateHasChanged();

        try
        {
            var result = await ConnectionState.TestConnectionAsync(connectionString, Model.Type);

            if (result.Success)
            {
                _testSuccessMessage = result.Databases.Count == 1
                    ? "Connection succeeded. Found 1 database."
                    : $"Connection succeeded. Found {result.Databases.Count} databases.";
            }
            else
            {
                ValidationError = DescribeFailure(result.Error);
            }
        }
        finally
        {
            _isTesting = false;
        }
    }

    /// <summary>
    /// Builds the connection string from whichever tab is showing and validates it, reporting problems inline.
    /// </summary>
    private async Task<string?> PrepareConnectionStringAsync()
    {
        string connectionString;

        if (IsConnectionStringTabActive)
        {
            if (string.IsNullOrWhiteSpace(Model.ConnectionString))
            {
                ValidationError = "Connection string is required";
                return null;
            }

            connectionString = Model.ConnectionString.Trim();
        }
        else
        {
            if (_form != null)
            {
                await _form.ValidateAsync();
                if (!_form.IsValid)
                    return null;
            }

            connectionString = ConnectionStringComposer.Build(Model, Model.ConnectionString);
        }

        var provider = ProviderFactory.GetProvider(Model.Type);
        if (!provider.ValidateConnectionString(connectionString, out var error))
        {
            ValidationError = error;
            return null;
        }

        return connectionString;
    }

    private string ResolveName(string connectionString)
    {
        if (!string.IsNullOrWhiteSpace(Model.Name))
            return Model.Name.Trim();

        return ConnectionStringComposer.DescribeTarget(Model.Type, connectionString) ?? Model.Type.ToString();
    }

    private string DescribeFailure(string? error)
    {
        var message = string.IsNullOrWhiteSpace(error) ? "Could not connect to the server." : error;

        if (Model.Type == DatabaseType.SQLServer && message.Contains("certificate", StringComparison.OrdinalIgnoreCase))
        {
            message += " For local or self-signed servers, turn on Trust Server Certificate (TrustServerCertificate=True).";
        }

        return message;
    }

    private void ClearFeedback()
    {
        ValidationError = null;
        _testSuccessMessage = null;
    }

    private void Cancel() => MudDialog.Cancel();
}
