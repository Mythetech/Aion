@page "/"
@using Aion.Components.Connections.Commands
@using Mythetech.Framework.Infrastructure.MessageBus
@using MudBlazor
@using Aion.Components.Querying
@using Aion.Components.Querying.Commands
@using MudBlazor.Utilities
@using Aion.Components.RequestContextPanel
@using Aion.Components.RequestContextPanel.Commands
@using Aion.Components.Shared
@using Aion.Components.Shortcuts
@using Aion.Components.Theme
@using Microsoft.JSInterop
@implements IAsyncDisposable
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.RequestContextPanel.Commands.OpenRequestContextPanel>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.RequestContextPanel.Commands.OpenJsonDetailView>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.RequestContextPanel.Commands.OpenForeignKeyView>


<MudStack Row="true" Class="w-100 h-100 pl-1 pr-1" Spacing="0">
    <MudSplitPanel @ref="_outerSplitter" PanelGap="2" Transparent="true" MinPanelSize="50"
                   Class="@($"w-100 h-100{(_sidePanelClosed ? " divider-locked" : "")}")">
        <FirstPanel>
            <MudSplitPanel Horizontal="true" PanelGap="2" Transparent="true" MinPanelSize="150" Class="w-100 h-100">
                <FirstPanel>
                    <MudPaper Height="100%" Elevation="0" Width="100%">
                        <QueryEditor />
                    </MudPaper>
                </FirstPanel>
                <SecondPanel>
                    <QueryResponsePanel />
                </SecondPanel>
            </MudSplitPanel>
        </FirstPanel>
        <SecondPanel>
            @if (!_sidePanelClosed)
            {
                <MudPaper Height="100%" Width="100%">
                    <RequestContextPanel Request="@_panelRequest" PanelClosed="@CloseSidePanelAsync" />
                </MudPaper>
            }
            else
            {
                <div class="side-panel-strip">
                    <AionIconButton Size="Size.Small" Tooltip="Info Panel" Icon="@AionIcons.Info" OnClick="@(() => ToggleSidePanel("Info"))" />
                    @if (QueryState?.Active?.Transaction.HasValue ?? false)
                    {
                        <AionIconButton Tooltip="Transactions" Icon="@AionIcons.Transaction" OnClick="@(() => ToggleSidePanel("Transactions"))"></AionIconButton>
                    }
                </div>
            }
        </SecondPanel>
    </MudSplitPanel>
    <QueryAutoSaver />
    <ChordHotkey Chord="@Keys.NewQuery" OnPressed="@HandleNewQuery" />
    <ChordHotkey Chord="@Keys.NewQueryAlternate" OnPressed="@HandleNewQuery" />
    <ChordHotkey Chord="@Keys.NewConnection" OnPressed="@HandleNewConnection" />
</MudStack>



@code {
    [Inject]
    protected GlobalAppState AppState { get; set; } = default!;

    [Inject] protected IMessageBus Bus { get; set; } = default!;

    [Inject] protected QueryState QueryState { get; set; } = default!;

    [Inject] protected IJSRuntime JS { get; set; } = default!;

    [Inject] protected AionKeyBindings Keys { get; set; } = default!;

    // The panel is only rendered while open, so every open goes through this request instead of a component
    // reference that is null until the panel's first render.
    private SidePanelRequest? _panelRequest;

    private MudSplitPanel _outerSplitter = default!;

    private bool _sidePanelClosed = true;

    private IJSObjectReference? _layoutModule;

    private async Task<IJSObjectReference> GetLayoutModuleAsync() =>
        _layoutModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Aion.Components/js/layout.js");

    private async Task<int> GetOuterSplitterWidthAsync()
    {
        var module = await GetLayoutModuleAsync();
        return await module.InvokeAsync<int>("getElementWidth", ".mud-split-panel", 800);
    }

    protected async Task ToggleSidePanel(string selectedTab = "")
    {
        if (_sidePanelClosed)
        {
            await OpenSidePanelAsync(new SidePanelRequest
            {
                View = string.IsNullOrWhiteSpace(selectedTab) ? SidePanelRequest.InfoView : selectedTab
            });
        }
        else
        {
            await CloseSidePanelAsync();
        }
    }

    private async Task OpenSidePanelAsync(SidePanelRequest request)
    {
        _panelRequest = request;

        if (_sidePanelClosed)
        {
            await SetSidePanelOpenAsync(true);
        }
        else
        {
            StateHasChanged();
        }
    }

    private Task CloseSidePanelAsync() => SetSidePanelOpenAsync(false);

    private async Task SetSidePanelOpenAsync(bool open)
    {
        _sidePanelClosed = !open;
        StateHasChanged();
        await Task.Yield();

        var containerWidth = await GetOuterSplitterWidthAsync();
        await _outerSplitter.SetDividerPositionAsync(open
            ? SidePanelLayout.OpenDividerPosition(containerWidth)
            : SidePanelLayout.ClosedDividerPosition(containerWidth));

        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Bus.Subscribe<OpenRequestContextPanel>(this);
        Bus.Subscribe<OpenJsonDetailView>(this);
        Bus.Subscribe<OpenForeignKeyView>(this);
        QueryState.StateChanged += StateHasChanged;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_sidePanelClosed)
            {
                var containerWidth = await GetOuterSplitterWidthAsync();
                await _outerSplitter.SetDividerPositionAsync(SidePanelLayout.ClosedDividerPosition(containerWidth));
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        Bus.Unsubscribe<OpenRequestContextPanel>(this);
        Bus.Unsubscribe<OpenJsonDetailView>(this);
        Bus.Unsubscribe<OpenForeignKeyView>(this);
        QueryState.StateChanged -= StateHasChanged;

        if (_layoutModule is not null)
        {
            try
            {
                await _layoutModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The webview is already gone when the app closes, and the module went with it.
            }
        }
    }

    public async Task Consume(OpenRequestContextPanel message)
    {
        await InvokeAsync(() => OpenSidePanelAsync(new SidePanelRequest { View = message.View, JsonArgs = message.Args }));
    }

    public async Task Consume(OpenJsonDetailView message)
    {
        await InvokeAsync(() => OpenSidePanelAsync(new SidePanelRequest
        {
            View = SidePanelRequest.JsonView,
            JsonDetail = message.ColumnDetail
        }));
    }

    public async Task Consume(OpenForeignKeyView message)
    {
        await InvokeAsync(() => OpenSidePanelAsync(new SidePanelRequest
        {
            View = SidePanelRequest.ForeignKeyView,
            ForeignKey = message.ForeignKeyDetail,
            ForeignKeyChoices = message.Choices ?? []
        }));
    }

    private async Task HandleNewQuery()
    {
        var isInputField = await IsInputFieldFocusedAsync();
        if (!isInputField)
        {
            await Bus.PublishAsync(new CreateQuery());
        }
    }

    private async Task HandleNewConnection()
    {
        var isInputField = await IsInputFieldFocusedAsync();
        if (!isInputField)
        {
            await Bus.PublishAsync(new PromptCreateConnection());
        }
    }

    private async Task<bool> IsInputFieldFocusedAsync()
    {
        try
        {
            var module = await GetLayoutModuleAsync();
            return await module.InvokeAsync<bool>("isEditableElementFocused");
        }
        catch (JSException)
        {
            return false;
        }
    }
}
