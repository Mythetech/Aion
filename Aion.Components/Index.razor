@page "/"
@using Aion.Components.Connections.Commands
@using Mythetech.Framework.Infrastructure.MessageBus
@using MudBlazor
@using Aion.Components.Querying
@using Aion.Components.Querying.Commands
@using MudBlazor.Utilities
@using Aion.Components.RequestContextPanel
@using Aion.Components.RequestContextPanel.Commands
@using Aion.Components.Shared
@using Aion.Components.Theme
@using Microsoft.JSInterop
@implements IDisposable
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.RequestContextPanel.Commands.OpenRequestContextPanel>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.RequestContextPanel.Commands.OpenJsonDetailView>
@implements Mythetech.Framework.Infrastructure.MessageBus.IConsumer<Aion.Components.RequestContextPanel.Commands.OpenForeignKeyView>


<MudStack Row="true" Class="w-100 h-100 pl-1 pr-1" Spacing="0">
    <MudSplitPanel @ref="_outerSplitter" PanelGap="2" Transparent="true" MinPanelSize="50"
                   Class="@($"w-100 h-100{(_sidePanelClosed ? " divider-locked" : "")}")">
        <FirstPanel>
            <MudSplitPanel Horizontal="true" PanelGap="2" Transparent="true" MinPanelSize="150" Class="w-100 h-100">
                <FirstPanel>
                    <MudPaper Height="100%" Elevation="0" Width="100%">
                        <QueryEditor />
                    </MudPaper>
                </FirstPanel>
                <SecondPanel>
                    <QueryResponsePanel />
                </SecondPanel>
            </MudSplitPanel>
        </FirstPanel>
        <SecondPanel>
            @if (!_sidePanelClosed)
            {
                <MudPaper Height="100%" Width="100%">
                    <RequestContextPanel @ref="_requestContextPanel" PanelClosed="@(() => ToggleSidePanel())" />
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3" AlignItems="AlignItems.Center" Class="w-100 h-100 pt-2"
                          Style="border-left: solid 1px var(--mud-palette-primary); min-width: 48px">
                    <AionIconButton Size="Size.Small" Tooltip="Info Panel" Icon="@AionIcons.Info" OnClick="@(() => ToggleSidePanel("Info"))" />
                    @if (QueryState?.Active?.Transaction.HasValue ?? false)
                    {
                        <AionIconButton Tooltip="Transactions" Icon="@AionIcons.Transaction" OnClick="@(() => ToggleSidePanel("Transactions"))"></AionIconButton>
                    }
                </MudStack>
            }
        </SecondPanel>
    </MudSplitPanel>
    <MudHotkey Key="JsKey.Enter" KeyModifiers="@CtrlOnly" OnHotkeyPressed="@HandleRunQuery" />
    <MudHotkey Key="JsKey.Enter" KeyModifiers="@MetaOnly" OnHotkeyPressed="@HandleRunQuery" />
    <MudHotkey Key="JsKey.KeyT" KeyModifiers="@CtrlOnly" OnHotkeyPressed="@HandleNewQuery" />
    <MudHotkey Key="JsKey.KeyT" KeyModifiers="@MetaOnly" OnHotkeyPressed="@HandleNewQuery" />
    <MudHotkey Key="JsKey.KeyN" KeyModifiers="@CtrlOnly" OnHotkeyPressed="@HandleNewConnection" />
    <MudHotkey Key="JsKey.KeyN" KeyModifiers="@MetaOnly" OnHotkeyPressed="@HandleNewConnection" />
</MudStack>



@code {
    [Inject]
    protected GlobalAppState AppState { get; set; } = default!;

    [Inject] protected IMessageBus Bus { get; set; } = default!;

    [Inject] protected QueryState QueryState { get; set; } = default!;

    [Inject] protected IJSRuntime JS { get; set; } = default!;

    private RequestContextPanel.RequestContextPanel _requestContextPanel = default!;
    
    private MudSplitPanel _outerSplitter = default!;

    private bool _sidePanelClosed = true;
    
    private async Task<int> GetOuterSplitterWidthAsync()
    {
        return await JS.InvokeAsync<int>("eval",
            "document.querySelector('.mud-split-panel')?.getBoundingClientRect().width ?? 800");
    }

    protected async Task ToggleSidePanel(string selectedTab = "")
    {
        _sidePanelClosed = !_sidePanelClosed;
        StateHasChanged();
        await Task.Yield();

        var containerWidth = await GetOuterSplitterWidthAsync();

        if (_sidePanelClosed)
        {
            await _outerSplitter.SetDividerPositionAsync(containerWidth - 52);
        }
        else
        {
            await _outerSplitter.SetDividerPositionAsync((int)(containerWidth * 0.8));

            if (!string.IsNullOrWhiteSpace(selectedTab))
            {
                StateHasChanged();
                await Task.Yield();
                _requestContextPanel?.Open(selectedTab);
            }
        }

        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Bus.Subscribe<OpenRequestContextPanel>(this);
        Bus.Subscribe<OpenJsonDetailView>(this);
        Bus.Subscribe<OpenForeignKeyView>(this);
        QueryState.StateChanged += StateHasChanged;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_sidePanelClosed)
            {
                var containerWidth = await GetOuterSplitterWidthAsync();
                await _outerSplitter.SetDividerPositionAsync(containerWidth - 52);
            }
        }
    }

    public void Dispose()
    {
        Bus.Unsubscribe<OpenRequestContextPanel>(this);
        Bus.Unsubscribe<OpenJsonDetailView>(this);
        Bus.Unsubscribe<OpenForeignKeyView>(this);
        QueryState.StateChanged -= StateHasChanged;
    }

    public Task Consume(OpenRequestContextPanel message)
    {
        _sidePanelClosed = false;
        _requestContextPanel.Open(message.View, message.Args);
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task Consume(OpenJsonDetailView message)
    {
        _sidePanelClosed = false;
        _requestContextPanel.OpenJsonDetailView(message.ColumnDetail);
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task Consume(OpenForeignKeyView message)
    {
        _sidePanelClosed = false;
        _requestContextPanel.OpenForeignKeyDetailView(message.ForeignKeyDetail);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static readonly IEnumerable<JsKeyModifier> CtrlOnly = new[] { JsKeyModifier.ControlLeft };
    private static readonly IEnumerable<JsKeyModifier> MetaOnly = new[] { JsKeyModifier.MetaLeft };

    private async Task HandleRunQuery()
    {
        await Bus.PublishAsync(new RunQuery());
    }

    private async Task HandleNewQuery()
    {
        var isInputField = await IsInputFieldFocusedAsync();
        if (!isInputField)
        {
            await Bus.PublishAsync(new CreateQuery());
        }
    }

    private async Task HandleNewConnection()
    {
        var isInputField = await IsInputFieldFocusedAsync();
        if (!isInputField)
        {
            await Bus.PublishAsync(new PromptCreateConnection());
        }
    }

    private async Task<bool> IsInputFieldFocusedAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("eval", 
                "document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA' || document.activeElement.isContentEditable)");
        }
        catch
        {
            return false;
        }
    }
}
