@using Aion.Components.Theme
@using Aion.Contracts.Database

<MudDialog Class="schema-wizard">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@AionIcons.Connection" />
            <MudText Typo="Typo.h6">New Database</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStepper @ref="_stepper"
                    @bind-ActiveIndex="_activeIndex">
            <ActionContent Context="stepper">
                <MudButton OnClick="Cancel"
                           Color="Color.Default">
                    Cancel
                </MudButton>
                <MudButton StartIcon="@AionIcons.Back"
                           OnClick="@stepper.PreviousStepAsync"
                           Disabled="@(!stepper.PreviousStepEnabled)">
                    Back
                </MudButton>
                <MudSpacer />
                @if (_activeIndex > 0)
                {
                    <MudButton StartIcon="@AionIcons.Add"
                               Color="Color.Default"
                               OnClick="AddTable">
                        Add Table
                    </MudButton>
                }
                @if (!stepper.CanGoToNextStep)
                {
                    <MudTooltip Text="@FinishBlockedReason">
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="@(Problems.Count > 0 || _creating)"
                                   OnClick="FinishAsync">
                            Finish
                        </MudButton>
                    </MudTooltip>
                }
                else
                {
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="@stepper.NextStepAsync">
                        Next
                    </MudButton>
                }
            </ActionContent>
            <ChildContent>
                <MudStep Title="Database">
                    <MudStack Spacing="3" Class="pa-2">
                        <MudTextField @bind-Value="_model.DatabaseName"
                                      Label="Database Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Database name is required" />

                        <MudSelect T="DatabaseType"
                                   Value="_model.EngineType"
                                   ValueChanged="ChangeEngine"
                                   Label="Engine"
                                   Variant="Variant.Outlined">
                            @foreach (var provider in TypeProviders)
                            {
                                <MudSelectItem Value="@provider.DatabaseType">
                                    @GetEngineLabel(provider.DatabaseType)
                                </MudSelectItem>
                            }
                        </MudSelect>

                        @if (_typeChanges.Count > 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="type-changes">
                                <MudText Typo="Typo.body2">Column types were changed for @GetEngineLabel(_model.EngineType):</MudText>
                                <ul>
                                    @foreach (var change in _typeChanges)
                                    {
                                        <li>@DescribeChange(change)</li>
                                    }
                                </ul>
                            </MudAlert>
                        }
                    </MudStack>
                </MudStep>

                @for (int i = 0; i < _model.Tables.Count; i++)
                {
                    var table = _model.Tables[i];
                    var index = i;

                    <MudStep Title="@table.Label(index)">
                        <MudStack Spacing="2" Class="pa-2">
                            @if (_model.Tables.Count > 1)
                            {
                                <div class="d-flex justify-end">
                                    <MudButton StartIcon="@AionIcons.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Variant="Variant.Text"
                                               OnClick="@(() => RemoveTable(index))">
                                        Remove Table
                                    </MudButton>
                                </div>
                            }
                            <TableDefinitionStep Table="table"
                                                 SupportedTypes="@GetSupportedTypes(_model.EngineType)"
                                                 TableChanged="StateHasChanged" />
                        </MudStack>
                    </MudStep>
                }
            </ChildContent>
        </MudStepper>

        @if (OnLastStep && Problems.Count > 0)
        {
            <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-3 finish-problems">
                <MudText Typo="Typo.body2">To finish:</MudText>
                <ul>
                    @foreach (var problem in Problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            </MudAlert>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private ISchemaExecutor SchemaExecutor { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<ISupportedTypeProvider> TypeProviders { get; set; } = [];

    [Parameter]
    public DatabaseType? InitialEngine { get; set; }

    /// <summary>Databases the browser already holds, whose names a new database can't reuse.</summary>
    [Parameter]
    public IReadOnlyCollection<string> ExistingDatabaseNames { get; set; } = [];

    private MudStepper _stepper = default!;
    private int _activeIndex;
    private readonly SchemaWizardModel _model = new();
    private IReadOnlyList<ColumnTypeChange> _typeChanges = [];
    private string? _error;
    private bool _creating;

    protected override void OnInitialized()
    {
        if (InitialEngine is { } engine && TypeProviders.Any(p => p.DatabaseType == engine))
            _model.EngineType = engine;
        else if (TypeProviders.Count > 0)
            _model.EngineType = TypeProviders[0].DatabaseType;
    }

    // The Database step comes first, then one step per table, so the last table's step is where Finish appears.
    private bool OnLastStep => _activeIndex >= _model.Tables.Count;

    private IReadOnlyList<string> Problems => SchemaWizardValidation.Problems(_model, ExistingDatabaseNames);

    private string? FinishBlockedReason => Problems switch
    {
        [] => null,
        [var only] => only,
        [var first, ..] => $"{first}, and {Problems.Count - 1} more listed below"
    };

    private IReadOnlyList<string> GetSupportedTypes(DatabaseType engine)
    {
        var provider = TypeProviders.FirstOrDefault(p => p.DatabaseType == engine);
        return provider?.SupportedTypes ?? [];
    }

    private void ChangeEngine(DatabaseType engine)
    {
        _typeChanges = _model.ChangeEngine(engine, GetSupportedTypes(engine));
    }

    private static string DescribeChange(ColumnTypeChange change) => change.To is { } to
        ? $"{change.Table}.{change.Column}: {change.From} is now {to}"
        : $"{change.Table}.{change.Column}: {change.From} has no equivalent, so pick a type";

    private static string GetEngineLabel(DatabaseType type) => type switch
    {
        DatabaseType.WasmSQLite => "SQLite (In-Browser)",
        DatabaseType.WasmPostgreSQL => "PostgreSQL (PGlite)",
        _ => type.ToString()
    };

    private void AddTable()
    {
        _model.Tables.Add(new TableDefinitionModel());
    }

    private void RemoveTable(int index)
    {
        if (_model.Tables.Count <= 1) return;
        _model.Tables.RemoveAt(index);
        if (_activeIndex > _model.Tables.Count)
            _activeIndex = _model.Tables.Count;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task FinishAsync()
    {
        _error = null;

        if (Problems.Count > 0)
            return;

        _creating = true;
        var result = await SchemaExecutor.ExecuteAsync(_model);
        _creating = false;

        // Staying open keeps everything the user entered, so fixing the table that failed is one edit away.
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }

        MudDialog.Close(DialogResult.Ok(result.Connection));
    }
}
