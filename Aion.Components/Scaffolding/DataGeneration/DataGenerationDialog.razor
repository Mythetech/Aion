@using Aion.Components.Connections
@using Aion.Components.Theme
@using Aion.Contracts.Database

<MudDialog Class="data-generation-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@AionIcons.Add" />
            <MudText Typo="Typo.h6">Generate Data: @TableName</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!_supported)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Generating data is not supported for @Provider.DatabaseType connections.
                </MudAlert>
            }
            else
            {
                <MudNumericField @bind-Value="_model.RowCount"
                                 Label="Number of Rows"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="@DataGenerationPlan.MaxRows"
                                 Disabled="@_generating" />

                <MudText Typo="Typo.subtitle2">Column Generators</MudText>

                <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                    <thead>
                        <tr>
                            <th>Column</th>
                            <th>Type</th>
                            <th>Generator</th>
                            <th>Options</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var binding in _model.ColumnGenerators)
                        {
                            <tr class="@(binding.FilledByDatabase is not null ? "mud-text-disabled" : "")">
                                <td>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        @if (binding.Column.IsPrimaryKey)
                                        {
                                            <MudIcon Icon="@AionIcons.Key" Size="Size.Small" Color="Color.Warning" />
                                        }
                                        <MudText Typo="Typo.body2">@binding.Column.Name</MudText>
                                    </MudStack>
                                </td>
                                <td>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@ColumnTypeText.Short(binding.Column, Provider.DatabaseType)</MudText>
                                </td>
                                <td>
                                    @if (binding.FilledByDatabase is { } reason)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Filled by the database (@reason)</MudText>
                                    }
                                    else
                                    {
                                        var generators = DataGenerationPlan.CompatibleGenerators(binding);
                                        <MudSelect @bind-Value="binding.Generator"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Class="generator-select"
                                                   Placeholder="@(generators.Count == 0 ? "Nothing fits this type" : "Choose a generator")"
                                                   Disabled="@_generating">
                                            @foreach (var gen in generators)
                                            {
                                                <MudSelectItem Value="@gen">@gen.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                </td>
                                <td>
                                    @if (binding.FilledByDatabase is null)
                                    {
                                        @switch (binding.Generator)
                                        {
                                            case AutoIncrementGenerator:
                                                <MudNumericField T="int?"
                                                                 @bind-Value="binding.Options.StartValue"
                                                                 Label="Start"
                                                                 Placeholder="After the highest"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Class="option-start" />
                                                break;

                                            case RandomIntGenerator or RandomNumberGenerator:
                                                <MudStack Row="true" Spacing="1">
                                                    <MudNumericField T="int?"
                                                                     @bind-Value="binding.Options.MinValue"
                                                                     Label="Min"
                                                                     Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense"
                                                                     Class="option-number" />
                                                    <MudNumericField T="int?"
                                                                     @bind-Value="binding.Options.MaxValue"
                                                                     Label="Max"
                                                                     Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense"
                                                                     Class="option-number" />
                                                </MudStack>
                                                break;

                                            case DateRangeGenerator:
                                                <MudStack Row="true" Spacing="1">
                                                    <MudDatePicker @bind-Date="binding.Options.MinDate"
                                                                   Label="From"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense" />
                                                    <MudDatePicker @bind-Date="binding.Options.MaxDate"
                                                                   Label="To"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense" />
                                                </MudStack>
                                                break;

                                            case CustomListGenerator:
                                                <MudTextField @bind-Value="binding.Options.CustomValues"
                                                              Label="Values (comma-separated)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Immediate="true"
                                                              Class="option-values" />
                                                break;
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                @if (Problems.Count > 0 && !_generating)
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Class="generate-problems">
                        <MudText Typo="Typo.body2">To generate:</MudText>
                        <ul>
                            @foreach (var problem in Problems)
                            {
                                <li>@problem</li>
                            }
                        </ul>
                    </MudAlert>
                }

                @if (_generating)
                {
                    <MudStack Spacing="1">
                        <MudProgressLinear Value="@_progress" Max="@_model.RowCount" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Align="Align.Center">
                            @_progress / @_model.RowCount rows
                        </MudText>
                    </MudStack>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }

                @if (_inserted is { } inserted)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        Added @inserted.ToString("N0") rows to @TableName
                    </MudAlert>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="@_generating">@(_inserted is null ? "Cancel" : "Close")</MudButton>
        <MudSpacer />
        <MudTooltip Text="@GenerateBlockedReason">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(_generating || !_supported || Problems.Count > 0)"
                       OnClick="GenerateAsync">
                @if (_generating)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Generate
            </MudButton>
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string TableName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Schema { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Database { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public List<ColumnInfo> Columns { get; set; } = [];

    [Parameter, EditorRequired]
    public IDatabaseProvider Provider { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ConnectionString { get; set; } = string.Empty;

    private readonly DataGenerationModel _model = new();
    private readonly DataGenerationService _service = new();
    private bool _supported;
    private bool _generating;
    private int _progress;
    private string? _error;
    private int? _inserted;

    protected override void OnInitialized()
    {
        _supported = Provider is ISqlDialectProvider;
        _model.TableName = TableName;
        _model.Schema = Schema;
        _model.Database = Database;
        _model.ColumnGenerators = DataGenerationPlan.CreateBindings(Columns, Provider.DatabaseType);
    }

    private IReadOnlyList<string> Problems => DataGenerationPlan.Problems(_model);

    private string? GenerateBlockedReason => Problems switch
    {
        [] => null,
        [var only] => only,
        [var first, ..] => $"{first}, and {Problems.Count - 1} more listed above"
    };

    private async Task GenerateAsync()
    {
        _generating = true;
        _error = null;
        _inserted = null;
        _progress = 0;

        var result = await _service.GenerateAsync(_model, Provider, ConnectionString, ShowProgressAsync);

        _generating = false;
        if (result.Success)
            _inserted = result.RowsInserted;
        else
            _error = result.Error;
    }

    // Runs on the renderer between batches, so the bar moves while the rows are inserted.
    private Task ShowProgressAsync(int inserted)
    {
        _progress = inserted;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(_inserted is > 0));
}
