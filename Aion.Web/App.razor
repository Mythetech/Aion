@using Aion.Components.Connections.Services
@using Aion.Web.Services

<Routes />

@code {
    [Inject] protected StorageRestoreService RestoreService { get; set; } = default!;
    [Inject] protected IConnectionHealthMonitor HealthMonitor { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await RestoreService.RestoreAsync();
        await HealthMonitor.StartAsync();
        await base.OnInitializedAsync();
    }
}
